msgstr "Ti senti in forma abbastanza da rifarlo."

#. You_feel variant, selected when Unaware
#: src/mhitu.c:2236
msgid "You dream that you feel good enough to do it again."
msgstr "Sogni di sentirti in forma abbastanza da rifarlo."

#: src/mhitu.c:2248
msgid "That was a very educational experience."
msgstr "È stata un'esperienza molto istruttiva."

#: src/mhitu.c:2253
msgid "You feel restored to health!"
msgstr "Ti senti tornare in salute!"

#. You_feel variant, selected when Unaware
#: src/mhitu.c:2253
msgid "You dream that you feel restored to health!"
msgstr "Sogni di sentirti tornare in salute!"

#: src/mhitu.c:2289
msgid "\"It's on the house!\""
msgstr "\"Offre la casa!\""

#: src/mhitu.c:2291
msgid "No charge."
msgstr "Nessun costo."

#: src/mhitu.c:2527 src/uhitm.c:5765
msgid "You explode!"
msgstr "Esplodi!"

#: src/minion.c:247
msgid "\"Thou shalt pay for thine indiscretion!\""
msgstr "\"Pagherai per la tua indiscrezione!\""

#: src/minion.c:269
msgid "You feel tension building."
msgstr "Senti crescere la tensione."

#. You_feel variant, selected when Unaware
#: src/minion.c:269
msgid "You dream that you feel tension building."
msgstr "Sogni di sentire crescere la tensione."

#: src/minion.c:376
msgid "You refuse."
msgstr "Rifiuti."

#: src/minion.c:478
msgid "\"Since you desire conflict, have some more!\""
msgstr "\"Poiché desideri il conflitto, eccone ancora!\""

#: src/minion.c:507
msgid "A voice booms:"
msgstr "Una voce tuona:"

#: src/minion.c:509
msgid "You feel a booming voice:"
msgstr "Senti una voce tonante:"

#. You_feel variant, selected when Unaware
#: src/minion.c:509
msgid "You dream that you feel a booming voice:"
msgstr "Sogni di sentire una voce tonante:"

#: src/minion.c:511
msgid "\"Thy desire for conflict shall be fulfilled!\""
msgstr "\"Il tuo desiderio di conflitto sarà esaudito!\""

#: src/minion.c:516
msgid "A voice whispers:"
msgstr "Una voce sussurra:"

#: src/minion.c:518
msgid "You feel a soft voice:"
msgstr "Senti una voce sommessa:"

#. You_feel variant, selected when Unaware
#: src/minion.c:518
msgid "You dream that you feel a soft voice:"
msgstr "Sogni di sentire una voce sommessa:"

#: src/minion.c:520
msgid "\"Thou hast been worthy of me!\""
msgstr "\"Hai meritato la mia stima!\""

#: src/minion.c:542
msgid "An angel appears near you."
msgstr "Un angelo appare accanto a te."

#: src/minion.c:544
msgid "You feel the presence of a friendly angel near you."
msgstr "Senti la presenza di un angelo amico accanto a te."

#. You_feel variant, selected when Unaware
#: src/minion.c:544
msgid "You dream that you feel the presence of a friendly angel near you."
msgstr "Sogni di sentire la presenza di un angelo amico accanto a te."

#: src/mklev.c:2423
