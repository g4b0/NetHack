# Test catalog for test/test_i18n.lua.  "zz" is not a real language; the
# file is copied into the playground by tools/nhtest.py and is never
# installed.  Entries marked BAD are malformed on purpose.

msgid ""
msgstr ""
"Project-Id-Version: nethack-i18n-test\n"
"Language: zz\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"

# plain lookup
msgid "plain"
msgstr "PLAIN"

# context: same msgid with and without it
msgctxt "menu"
msgid "Open"
msgstr "OPEN-MENU"

msgid "Open"
msgstr "OPEN-NOCTX"

msgctxt "menu"
msgid "Close"
msgstr "CLOSE-MENU"

# plurals: two forms, three forms, one form, an empty second form
msgid "one thing"
msgid_plural "many things"
