# Italian messages for NetHack.
#
# Usage: OPTIONS=language:it in the config file or NETHACKOPTIONS.
#
# Format: a subset of GNU gettext PO, UTF-8.  The msgid is the English
# message exactly as it reaches the message window, prefix included:
# You("hit %s.") is looked up as "You hit %s.".  A translation may drop an
# argument or reorder them with %1$s, %2$s; it may not use a conversion
# of a different type than the English one (see src/i18n.c).  Anything
# untranslated stays English.
#
# This file is a starting set, not a complete translation.

msgid ""
msgstr ""
"Project-Id-Version: NetHack 5.0\n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: src/allmain.c:55
msgid "You are lucky!  Full moon tonight."
msgstr "Che fortuna!  Stanotte c'è la luna piena."

#: src/allmain.c:58
msgid "Be careful!  New moon tonight."
msgstr "Attenzione!  Stanotte c'è la luna nuova."

#: src/allmain.c:62
msgid "Watch out!  Bad things can happen on Friday the 13th."
msgstr "Occhio!  Il venerdì 13 possono succedere cose brutte."

#: src/allmain.c:258
msgid "The dungeon capitulates."
msgstr "Il dungeon si arrende."

#: src/allmain.c:452
msgid "The Amulet is bestowing a wish upon you!"
msgstr "L'Amuleto ti concede un desiderio!"

# ===== second pass: menu, prompt and putstr strings not used by pline =====
#. prompt
#: src/allmain.c:856
msgid "Continue rerolling?"
msgstr "Continui a ripetere il sorteggio?"

# JOKE: undead studio audience
#: src/allmain.c:915
msgid "NetHack is filmed in front of an undead studio audience."
msgstr "NetHack è girato davanti a un pubblico di non morti in studio."

# Arguments are the greeting, the hero's name and the role description in
# English; until the grammar interface exists the last one is left out
# rather than shown half-translated.
#: src/allmain.c:959
#, c-format
msgid "%s %s, welcome to NetHack!  You are a%s."
msgstr "%s %s, benvenuto in NetHack!"

#: src/apply.c:82
msgid "Using your camera underwater would void the warranty."
msgstr "Usare la fotocamera sott'acqua farebbe decadere la garanzia."

#: src/apply.c:120
msgid "You cannot use it while you're wearing it!"
msgstr "Non puoi usarlo mentre lo indossi!"

#: src/apply.c:177 src/do.c:2393
msgid "You've got the glop off."
msgstr "Hai tolto via la poltiglia."

#: src/apply.c:328 src/pickup.c:2203 src/pickup.c:2953
msgid "You have no hands!"
msgstr "Non hai mani!"

#: src/apply.c:331
msgid "You can't hear anything!"
msgstr "Non senti nulla!"

#: src/apply.c:362
msgid "You hear faint splashing."
msgstr "Senti un debole sciabordio."

#. You_hear variant, selected when Underwater
#: src/apply.c:362
msgid "You barely hear faint splashing."
msgstr "Senti a malapena un debole sciabordio."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/apply.c:362
msgid "You dream that you hear faint splashing."
msgstr "Sogni di sentire un debole sciabordio."

#: src/apply.c:369
msgid "You hear the crackling of hellfire."
msgstr "Senti il crepitio del fuoco infernale."

#. You_hear variant, selected when Underwater
#: src/apply.c:369
msgid "You barely hear the crackling of hellfire."
msgstr "Senti a malapena il crepitio del fuoco infernale."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/apply.c:369
msgid "You dream that you hear the crackling of hellfire."
msgstr "Sogni di sentire il crepitio del fuoco infernale."

#: src/apply.c:376
msgid "You hear your heart beat."
msgstr "Senti il battito del tuo cuore."

#. You_hear variant, selected when Underwater
#: src/apply.c:376
msgid "You barely hear your heart beat."
msgstr "Senti a malapena il battito del tuo cuore."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/apply.c:376
msgid "You dream that you hear your heart beat."
msgstr "Sogni di sentire il battito del tuo cuore."

#: src/apply.c:388
msgid "You hear a faint typing noise."
msgstr "Senti un debole ticchettio di tastiera."

#. You_hear variant, selected when Underwater
#: src/apply.c:388
msgid "You barely hear a faint typing noise."
msgstr "Senti a malapena un debole ticchettio di tastiera."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/apply.c:388
msgid "You dream that you hear a faint typing noise."
msgstr "Sogni di sentire un debole ticchettio di tastiera."

#: src/apply.c:451
msgid "The invisible monster must have moved."
msgstr "Il mostro invisibile deve essersi spostato."

#: src/apply.c:471
msgid "You hear nothing special."
msgstr "Non senti nulla di particolare."

#: src/apply.c:482 src/apply.c:501
msgid "You are incapable of using the whistle."
msgstr "Non sei in grado di usare il fischietto."

#: src/apply.c:738 src/mhitm.c:1004
msgid "Your leash falls slack."
msgstr "Il tuo guinzaglio si allenta."

#: src/apply.c:792
msgid "You cannot leash any more pets."
msgstr "Non puoi mettere il guinzaglio ad altri animali."

#: src/apply.c:805
msgid "Leash yourself?  Very funny..."
msgstr "Metterti il guinzaglio?  Molto divertente..."

#: src/apply.c:814
msgid "There is no creature there."
msgstr "Lì non c'è nessuna creatura."

#: src/apply.c:842
msgid "The leash would just fall off."
msgstr "Il guinzaglio cadrebbe subito."

#: src/apply.c:867
msgid "This leash is not attached to that creature."
msgstr "Questo guinzaglio non è attaccato a quella creatura."

#: src/apply.c:869
msgid "The leash would not come off!"
msgstr "Il guinzaglio non vuole staccarsi!"

#: src/apply.c:978
msgid "You pull on the leash."
msgstr "Tiri il guinzaglio."

#: src/apply.c:1048
msgid "You stiffen momentarily under your gaze."
msgstr "Per un attimo ti irrigidisci sotto il tuo stesso sguardo."

#: src/apply.c:1053
msgid "Yikes!  You've frozen yourself!"
msgstr "Accidenti!  Hai paralizzato te stesso!"

#: src/apply.c:1062
msgid "You don't have a reflection."
msgstr "Non hai un riflesso."

#: src/apply.c:1064
msgid "Huh?  That doesn't look like you!"
msgstr "Eh?  Quello non sembri tu!"

#: src/apply.c:1181
msgid "You feel a bit silly gesturing the mirror in that direction."
msgstr "Trovi un po' sciocco agitare lo specchio in quella direzione."

#. You_feel variant, selected when Unaware
#: src/apply.c:1181
msgid ""
"You dream that you feel a bit silly gesturing the mirror in that direction."
msgstr ""
"Sogni di trovare un po' sciocco agitare lo specchio in quella direzione."

#: src/apply.c:1219
msgid "But the sound is muffled."
msgstr "Ma il suono è attutito."

#: src/apply.c:1223
msgid "But it makes no sound."
msgstr "Ma non emette alcun suono."

#: src/apply.c:1299
msgid "Things open around you..."
msgstr "Intorno a te le cose si aprono..."

#: src/apply.c:1345
msgid "You cannot make fire under water."
msgstr "Non puoi accendere un fuoco sott'acqua."

#: src/apply.c:1399 src/apply.c:1713
msgid "You don't have enough elbow-room to maneuver."
msgstr "Non hai abbastanza spazio per manovrare."

#: src/apply.c:1664
msgid "Your lantern is out of power."
msgstr "La tua lanterna è scarica."

#: src/apply.c:1718
msgid "You snuff the lit potion."
msgstr "Spegni la pozione accesa."

#: src/apply.c:1733
msgid "There is not enough oxygen to sustain a fire."
msgstr "Non c'è abbastanza ossigeno per alimentare un fuoco."

#: src/apply.c:1753
msgid "\"That's in addition to the cost of the potion, of course.\""
msgstr "\"Questo si aggiunge al prezzo della pozione, naturalmente.\""

#: src/apply.c:1793
msgid "You aren't able to rub anything without hands."
msgstr "Senza mani non puoi strofinare nulla."

#: src/apply.c:1805 src/apply.c:4417
msgid "Sorry, I don't know how to use that."
msgstr "Spiacente, non so come usarlo."

#: src/apply.c:1841
msgid "Rubbing the electric lamp is not particularly rewarding."
msgstr "Strofinare la lampada elettrica non è particolarmente gratificante."

#: src/apply.c:1842
msgid "Anyway, nothing exciting happens."
msgstr "Comunque, non succede niente di emozionante."

#: src/apply.c:1903
msgid "Illegal move!"
msgstr "Mossa non valida!"

#: src/apply.c:1907 src/apply.c:3476 src/apply.c:3767
msgid "Too far!"
msgstr "Troppo lontano!"

#: src/apply.c:1911
msgid "You cannot jump there!"
msgstr "Non puoi saltare lì!"

#: src/apply.c:1915
msgid "You cannot see where to land!"
msgstr "Non vedi dove atterrare!"

#: src/apply.c:1947
msgid "You can't jump diagonally out of a doorway."
msgstr "Non puoi saltare in diagonale fuori da una porta."

#: src/apply.c:1954
msgid "There is an obstacle preventing that jump."
msgstr "C'è un ostacolo che impedisce quel salto."

#: src/apply.c:2002
msgid "You can't jump; you have no legs!"
msgstr "Non puoi saltare: non hai gambe!"

#: src/apply.c:2005
msgid "You can't jump very far."
msgstr "Non puoi saltare molto lontano."

#: src/apply.c:2014
msgid "You bounce around a little."
msgstr "Rimbalzi un po' qua e là."

#: src/apply.c:2017
msgid "You've got to be kidding!"
msgstr "Stai scherzando!"

#: src/apply.c:2021
msgid "You swish around a little."
msgstr "Ti agiti un po' nell'acqua."

#: src/apply.c:2024
msgid "This calls for swimming, not jumping!"
msgstr "Qui serve nuotare, non saltare!"

#: src/apply.c:2042
msgid "You flail around a little."
msgstr "Ti dimeni un po'."

#: src/apply.c:2045
msgid "You don't have enough traction to jump."
msgstr "Non hai abbastanza aderenza per saltare."

#: src/apply.c:2048
msgid "You are carrying too much to jump!"
msgstr "Porti troppo peso per saltare!"

#: src/apply.c:2051
msgid "You lack the strength to jump!"
msgstr "Non hai la forza per saltare!"

#: src/apply.c:2061
msgid "Where do you want to jump?"
msgstr "Dove vuoi saltare?"

#: src/apply.c:2084
msgid "You rip yourself free of the bear trap!  Ouch!"
msgstr "Ti liberi a forza dalla tagliola!  Ahi!"

#: src/apply.c:2090
msgid "You leap from the pit!"
msgstr "Balzi fuori dalla fossa!"

#: src/apply.c:2093
msgid "You tear the web apart as you pull yourself free!"
msgstr "Strappi la ragnatela mentre ti liberi!"

#: src/apply.c:2189
msgid "You seem to be out of tins."
msgstr "Sembra che le scatolette siano finite."

# speaker: the Rider War (pun: tinning = preserving)
#: src/apply.c:2215
msgid "\"Yes...  But War does not preserve its enemies...\""
msgstr "\"Sì...  Ma la Guerra non conserva i suoi nemici...\""

#: src/apply.c:2217
msgid "The corpse evades your grasp."
msgstr "Il cadavere sfugge alla tua presa."

#: src/apply.c:2221
msgid "That's too insubstantial to tin."
msgstr "È troppo inconsistente per essere inscatolato."

# JOKE: you break it
#: src/apply.c:2242 src/apply.c:2251
msgid "\"You tin it, you bought it!\""
msgstr "\"Se lo inscatoli, lo paghi!\""

#: src/apply.c:2520
msgid "You don't have enough room in here."
msgstr "Qui dentro non hai abbastanza spazio."

#: src/apply.c:2527
msgid "You cannot put the figurine there."
msgstr "Non puoi mettere la statuetta lì."

#: src/apply.c:2540
msgid "You cannot fit the figurine on the boulder."
msgstr "Non puoi far stare la statuetta sul masso."

#: src/apply.c:2714
msgid "You feel something shatter."
msgstr "Senti qualcosa andare in frantumi."

#. You_feel variant, selected when Unaware
#: src/apply.c:2714
msgid "You dream that you feel something shatter."
msgstr "Sogni di sentire qualcosa andare in frantumi."

#: src/apply.c:2716
msgid "Oh, wow, look at the pretty shards."
msgstr "Oh, wow, guarda che belle schegge."

#: src/apply.c:2725 src/apply.c:2811
msgid "\"scritch, scritch\""
msgstr "\"gratt, gratt\""

#: src/apply.c:2728
msgid "Oh wow, man: Fractals!"
msgstr "Oh wow, fratello: frattali!"

# JOKE: whetstone/wetstone pun
#: src/apply.c:2772
msgid "You must think this is a wetstone, do you?"
msgstr "Ti sembra forse una pietra da bagnare, questa?"

#: src/apply.c:2950
msgid "Your trap setting attempt fails."
msgstr "Il tuo tentativo di armare la trappola fallisce."

#: src/apply.c:2987
msgid "You miss."
msgstr "Manchi il bersaglio."

#: src/apply.c:3009
msgid "There is not enough room to flick your bullwhip."
msgstr "Non c'è abbastanza spazio per schioccare la frusta."

#: src/apply.c:3012
msgid "There is too much resistance to flick your bullwhip."
msgstr "C'è troppa resistenza per schioccare la frusta."

#: src/apply.c:3019 src/apply.c:3035
msgid "You cause a small splash."
msgstr "Provochi un piccolo spruzzo."

# JOKE: beat dead horse
#: src/apply.c:3049
msgid "Why beat a dead horse?"
msgstr "Perché infierire su un cavallo morto?"

#: src/apply.c:3115
msgid "You yank yourself out of the pit!"
msgstr "Ti tiri fuori dalla fossa con uno strattone!"

#: src/apply.c:3268
msgid "You snap your whip through thin air."
msgstr "Fai schioccare la frusta nel vuoto."

#: src/apply.c:3440 src/apply.c:3741
msgid "There's not enough room here to use that."
msgstr "Qui non c'è abbastanza spazio per usarlo."

#: src/apply.c:3457 src/apply.c:3756
msgid "Where do you want to hit?"
msgstr "Dove vuoi colpire?"

#: src/apply.c:3480
msgid "Don't know what to hit."
msgstr "Non so cosa colpire."

#: src/apply.c:3482
msgid "Too close!"
msgstr "Troppo vicino!"

#: src/apply.c:3485 src/apply.c:3770
msgid "You won't hit anything if you can't see that spot."
msgstr "Non colpirai nulla se non vedi quel punto."

#: src/apply.c:3488 src/apply.c:3773
msgid "You can't reach that spot from here."
msgstr "Non puoi raggiungere quel punto da qui."

#: src/apply.c:3507
msgid "The blade doesn't reach there!"
msgstr "La lama non arriva fin lì!"

# sword-ring sound effect (Snickersnee), kept as is
#: src/apply.c:3519
msgid "Shkinng!"
msgstr "Shkinng!"

#: src/apply.c:3560
msgid "You miss; there is no one there to hit."
msgstr "Manchi: lì non c'è nessuno da colpire."

#: src/apply.c:3581
msgid "You give yourself a facial."
msgstr "Ti fai una maschera di bellezza."

#. menu
#: src/apply.c:3795 src/do_name.c:525
msgid "a monster"
msgstr "un mostro"

#: src/apply.c:3865
msgid "You hook yourself!"
msgstr "Hai agganciato te stesso!"

#: src/apply.c:3956 src/apply.c:3993
msgid "But nothing else happens..."
msgstr "Ma non succede nient'altro..."

#: src/apply.c:4012
msgid "A wall of force smashes down around you!"
msgstr "Un muro di forza si abbatte intorno a te!"

#: src/apply.c:4221
msgid "You aren't able to use or apply tools in your current form."
msgstr "Nella tua forma attuale non puoi usare né applicare attrezzi."

#: src/apply.c:4403
msgid "It rings! ... But no-one answers."
msgstr "Squilla! ... Ma nessuno risponde."

#: src/apply.c:4477
msgid "You don't want to get the pages even more soggy, do you?"
msgstr "Non vorrai inzuppare ancora di più le pagine, vero?"

#: src/apply.c:4494
msgid "You feel the pages tremble."
msgstr "Senti le pagine tremare."

#. You_feel variant, selected when Unaware
#: src/apply.c:4494
msgid "You dream that you feel the pages tremble."
msgstr "Sogni di sentire le pagine tremare."

#: src/apply.c:4506
msgid "You enjoy the animated initials."
msgstr "Ti piacciono le iniziali animate."

#: src/apply.c:4508
msgid "This looks like it might be interesting to read."
msgstr "Sembra che possa essere interessante da leggere."

#: src/apply.c:4535
msgid "It tumbles away."
msgstr "Rotola via."

# JOKE: double header coin
#: src/apply.c:4550
msgid "Wow, a double header!"
msgstr "Wow, una moneta a doppia testa!"

#: src/apply.c:4550
msgid "The coin miraculously lands on its edge!"
msgstr "La moneta cade miracolosamente sul bordo!"

#. putstr
#: src/artifact.c:1161 src/artifact.c:1183
msgid "Artifacts"
msgstr "Artefatti"

#: src/artifact.c:1333
msgid "You lose magical energy!"
msgstr "Perdi energia magica!"

#: src/artifact.c:1348
msgid "You absorb magical energy!"
msgstr "Assorbi energia magica!"

# JOKE: Henry and Anne
#: src/artifact.c:1621
msgid "Good job Henry, but that wasn't Anne."
msgstr "Bel lavoro, Enrico, ma quella non era Anna Bolena."

#: src/artifact.c:1765
msgid "You feel a surge of power, but nothing seems to happen."
msgstr "Senti un'ondata di potere, ma sembra che non accada nulla."

#. You_feel variant, selected when Unaware
#: src/artifact.c:1765
msgid "You dream that you feel a surge of power, but nothing seems to happen."
msgstr "Sogni di sentire un'ondata di potere, ma sembra che non accada nulla."

#: src/artifact.c:1788 src/potion.c:1121 src/pray.c:414
msgid "You feel better."
msgstr "Ti senti meglio."

#. You_feel variant, selected when Unaware
#: src/artifact.c:1788 src/potion.c:1121 src/pray.c:414
msgid "You dream that you feel better."
msgstr "Sogni di sentirti meglio."

#: src/artifact.c:1829
msgid "You feel re-energized."
msgstr "Senti l'energia ritornare in te."

#. You_feel variant, selected when Unaware
#: src/artifact.c:1829
msgid "You dream that you feel re-energized."
msgstr "Sogni di sentire l'energia ritornare in te."

#: src/artifact.c:1922 src/teleport.c:1187
msgid "You feel very disoriented for a moment."
msgstr "Per un attimo perdi del tutto l'orientamento."

#. You_feel variant, selected when Unaware
#: src/artifact.c:1922 src/teleport.c:1187
msgid "You dream that you feel very disoriented for a moment."
msgstr "Sogni di perdere per un attimo del tutto l'orientamento."

#: src/artifact.c:1925
msgid "You are surrounded by a shimmering sphere!"
msgstr "Una sfera scintillante ti circonda!"

#: src/artifact.c:1927
msgid "You feel weightless for a moment."
msgstr "Per un attimo ti senti senza peso."

#. You_feel variant, selected when Unaware
#: src/artifact.c:1927
msgid "You dream that you feel weightless for a moment."
msgstr "Sogni di sentirti senza peso per un attimo."

#: src/artifact.c:2120 src/mcastu.c:331
msgid "You feel drained..."
msgstr "Senti l'energia abbandonarti..."

#. You_feel variant, selected when Unaware
#: src/artifact.c:2120 src/mcastu.c:331
msgid "You dream that you feel drained..."
msgstr "Sogni di sentire l'energia abbandonarti..."

#: src/artifact.c:2205
msgid "You feel like a rabble-rouser."
msgstr "Ti senti in vena di seminare discordia."

#. You_feel variant, selected when Unaware
#: src/artifact.c:2205
msgid "You dream that you feel like a rabble-rouser."
msgstr "Sogni di sentirti in vena di seminare discordia."

#: src/artifact.c:2207
msgid "You feel the tension decrease around you."
msgstr "Senti la tensione diminuire intorno a te."

#. You_feel variant, selected when Unaware
#: src/artifact.c:2207
msgid "You dream that you feel the tension decrease around you."
msgstr "Sogni di sentire la tensione diminuire intorno a te."

#: src/artifact.c:2226
msgid "Your body seems to unfade..."
msgstr "Il tuo corpo sembra tornare visibile..."

#: src/attrib.c:131
msgid "Your cap constricts briefly, then relaxes again."
msgstr "Il tuo cappello si stringe per un attimo, poi si rilassa di nuovo."

#: src/attrib.c:341
msgid "The poison doesn't seem to affect you."
msgstr "Il veleno non sembra farti effetto."

#: src/attrib.c:369 src/mthrowu.c:413 src/uhitm.c:1900 src/uhitm.c:3117
msgid "The poison was deadly..."
msgstr "Il veleno era mortale..."

#: src/ball.c:27
msgid "Startled, you drop the iron ball."
msgstr "Per lo spavento, lasci cadere la palla di ferro."

#: src/ball.c:59 src/dothrow.c:1387 src/read.c:2321 src/trap.c:1359
msgid "Fortunately, you are wearing a hard helmet."
msgstr "Per fortuna indossi un elmo rigido."

#: src/ball.c:791 src/dothrow.c:1091
msgid "You feel a tug from the iron ball."
msgstr "Senti uno strattone dalla palla di ferro."

#. You_feel variant, selected when Unaware
#: src/ball.c:791 src/dothrow.c:1091
msgid "You dream that you feel a tug from the iron ball."
msgstr "Sogni di sentire uno strattone dalla palla di ferro."

#: src/ball.c:797
msgid "You are jerked back by the iron ball!"
msgstr "La palla di ferro ti strattona all'indietro!"

#: src/ball.c:909
msgid "The web is destroyed!"
msgstr "La ragnatela viene distrutta!"

#: src/ball.c:1007
msgid "You lose your grip on the iron ball."
msgstr "Perdi la presa sulla palla di ferro."

#: src/ball.c:1014 src/ball.c:1029
msgid "The iron ball drags you downstairs!"
msgstr "La palla di ferro ti trascina giù per le scale!"

#: src/ball.c:1022
msgid "The iron ball smacks into you!"
msgstr "La palla di ferro ti sbatte addosso!"

#: src/bones.c:666
msgid "Discarding unusable bones; no need to panic..."
msgstr "Scarto un file bones inutilizzabile; niente panico..."

