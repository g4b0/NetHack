msgid "Unacceptable genders"
msgstr "Generi non accettabili"

#. menu
#: src/role.c:2751
msgid "Unacceptable alignments"
msgstr "Allineamenti non accettabili"

#: src/rumors.c:281
msgid "rumors not accessible."
msgstr "Voci non accessibili."

#: src/rumors.c:545 src/rumors.c:567
msgid "This cookie has a scrap of paper inside."
msgstr "Questo biscotto contiene un pezzetto di carta."

#: src/rumors.c:546
msgid "What a pity that you cannot read it!"
msgstr "Peccato che tu non possa leggerlo!"

#. putstr
#: src/rumors.c:674
msgid "The Oracle scornfully takes all your gold and says:"
msgstr "L'Oracolo prende sdegnosamente tutto il tuo oro e dice:"

#. putstr
#: src/rumors.c:674
msgid "The Oracle meditates for a moment and then intones:"
msgstr "L'Oracolo medita per un istante e poi intona:"

#. putstr
#: src/rumors.c:678
msgid "The message reads:"
msgstr "Il messaggio dice:"

#: src/rumors.c:708
msgid "There is no one here to consult."
msgstr "Qui non c'è nessuno da consultare."

#: src/rumors.c:714
msgid "You have no gold."
msgstr "Non hai oro."

#: src/rumors.c:726
msgid "You don't even have enough gold for that!"
msgstr "Non hai nemmeno abbastanza oro per questo!"

#. prompt
#: src/save.c:46
msgid "Really save?"
msgstr "Salvare davvero?"

#: src/save.c:52
msgid "Saving..."
msgstr "Salvataggio in corso..."

#: src/save.c:120
msgid "There seems to be an old save file."
msgstr "Sembra esserci un vecchio file di salvataggio."

#. prompt
#: src/save.c:121
msgid "Overwrite the old file?"
msgstr "Sovrascrivere il vecchio file?"

#: src/save.c:133
msgid "Cannot open save file."
msgstr "Impossibile aprire il file di salvataggio."

#. putstr
#: src/save.c:157
msgid "Saving:"
msgstr "Salvataggio:"

#: src/save.c:370
msgid "Probably someone removed it."
msgstr "Probabilmente qualcuno l'ha rimosso."

#: src/shk.c:206
msgid "You have no room for the gold!"
msgstr "Non hai spazio per l'oro!"

#: src/shk.c:529
msgid "But no one seems to respond to it."
msgstr "Ma nessuno sembra rispondere."

#: src/shk.c:545
msgid "The Keystone Kops appear!"
msgstr "Compaiono i Keystone Kops!"

#: src/shk.c:552
msgid "The Keystone Kops are after you!"
msgstr "I Keystone Kops ti danno la caccia!"

#: src/shk.c:700
msgid "You escaped the shop without paying!"
msgstr "Hai lasciato il negozio senza pagare!"

#: src/shk.c:803
msgid "\"Invisible customers are not welcome!\""
msgstr "\"I clienti invisibili non sono i benvenuti!\""

#: src/shk.c:1012
msgid "You have no credit or debt in here."
msgstr "Qui non hai né credito né debiti."

#: src/shk.c:1029
msgid "You have no credit in here."
msgstr "Qui non hai credito."

#: src/shk.c:1033
msgid "You don't owe any gold here."
msgstr "Qui non devi nulla."

#: src/shk.c:1305
msgid "The price is deducted from your credit."
msgstr "Il prezzo viene detratto dal tuo credito."

#: src/shk.c:1309
msgid "The price is partially covered by your credit."
msgstr "Il prezzo è coperto in parte dal tuo credito."

#: src/shk.c:1806
msgid "There appears to be no shopkeeper here to receive your payment."
msgstr "Qui non sembra esserci nessun negoziante a ricevere il tuo pagamento."

#: src/shk.c:1811
msgid "You can't see..."
msgstr "Non puoi vedere..."

#: src/shk.c:1839
msgid "Pay whom?"
msgstr "Pagare chi?"

#: src/shk.c:1847
msgid "Try again..."
msgstr "Riprova..."

# GENDER
#: src/shk.c:1851
msgid "You are generous to yourself."
msgstr "Sei generoso con te stesso."

#: src/shk.c:1860
msgid "There is no one there to receive your payment."
msgstr "Lì non c'è nessuno a ricevere il tuo pagamento."

#: src/shk.c:1899
msgid "But you have some gold stashed away."
msgstr "Ma hai un po' d'oro messo da parte."

#: src/shk.c:1910
msgid "But you have hidden gold!"
msgstr "Ma hai dell'oro nascosto!"

#: src/shk.c:2003
msgid "Your debt is covered by your credit."
msgstr "Il tuo debito è coperto dal tuo credito."

#: src/shk.c:2008
msgid "You pay that debt."
msgstr "Paghi quel debito."

#: src/shk.c:2016
msgid "That debt is partially offset by your credit."
msgstr "Quel debito è compensato in parte dal tuo credito."

#: src/shk.c:2017
msgid "You pay the remainder."
msgstr "Paghi il resto."

#: src/shk.c:2107
msgid "Maybe you have some gold stashed away?"
msgstr "Forse hai dell'oro messo da parte?"

#. prompt
#: src/shk.c:2130
msgid "Itemized billing?"
msgstr "Conto dettagliato?"

#: src/shk.c:3148
msgid "\"No thanks, I'd hang onto that if I were you.\""
msgstr "\"No, grazie.  Fossi in te, me lo terrei.\""

#: src/shk.c:3162
msgid "\"I won't stock that.  Take it out of here!\""
msgstr "\"Questa roba non la tengo.  Portala fuori di qui!\""

#: src/shk.c:3360 src/shk.c:3538
msgid "You got that for free!"
msgstr "L'hai avuto gratis!"

#: src/shk.c:3869
msgid "You have no credit remaining."
msgstr "Non hai più credito."

#: src/shk.c:3929 src/shk.c:6087
msgid "Your debt is paid off."
msgstr "Il tuo debito è saldato."

#: src/shk.c:4000
msgid "\"Thank you, scum!\""
msgstr "\"Grazie, feccia!\""

#: src/shk.c:4038
msgid ""
"\"Thank you for your contribution to restock this recently plundered shop.\""
msgstr ""
"\"Grazie del tuo contributo per rifornire questo negozio da poco "
"saccheggiato.\""

#. putstr
#: src/shk.c:4259
msgid "Unpaid articles already used up:"
msgstr "Articoli non pagati già consumati:"

#: src/shk.c:4409 src/shk.c:5308 src/vault.c:745
msgid "\"Out of my way, scum!\""
msgstr "\"Fuori dai piedi, feccia!\""

#: src/shk.c:4600
msgid "You hear someone muttering an incantation."
msgstr "Senti qualcuno borbottare una formula magica."

#. You_hear variant, selected when Underwater
#: src/shk.c:4600
msgid "You barely hear someone muttering an incantation."
msgstr "Senti a malapena qualcuno borbottare una formula magica."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/shk.c:4600
msgid "You dream that you hear someone muttering an incantation."
msgstr "Sogni di sentire qualcuno borbottare una formula magica."

#: src/shk.c:4678
msgid "\"Get your junk out of my wall!\""
msgstr "\"Togli la tua robaccia dal mio muro!\""

#: src/shk.c:4854
msgid "Suddenly, a section of the wall closes up!"
msgstr "All'improvviso, un tratto del muro si richiude!"

#: src/shk.c:4856
msgid "Suddenly, the shop door reappears!"
msgstr "All'improvviso, la porta del negozio riappare!"

#: src/shk.c:4861
msgid "You feel more claustrophobic than before."
msgstr "Senti crescere la claustrofobia."

#. You_feel variant, selected when Unaware
#: src/shk.c:4861
msgid "You dream that you feel more claustrophobic than before."
msgstr "Sogni di sentire crescere la claustrofobia."

#: src/shk.c:4863
msgid "The dungeon acoustics noticeably change."
msgstr "L'acustica del dungeon cambia in modo percepibile."

# GENDER
#: src/shk.c:5058 src/shk.c:5087
msgid "You feel like a common thief."
msgstr "Ti senti un ladro da quattro soldi."

# GENDER
#. You_feel variant, selected when Unaware
#: src/shk.c:5058 src/shk.c:5087
msgid "You dream that you feel like a common thief."
msgstr "Sogni di sentirti un ladro da quattro soldi."

#: src/shk.c:5306
msgid "You hear an angry voice:"
msgstr "Senti una voce irata:"

#. You_hear variant, selected when Underwater
#: src/shk.c:5306
msgid "You barely hear an angry voice:"
msgstr "Senti a malapena una voce irata:"

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/shk.c:5306
msgid "You dream that you hear an angry voice:"
msgstr "Sogni di sentire una voce irata:"

#: src/shk.c:5364
msgid "\"Oh, yes!  You'll pay!\""
msgstr "\"Eccome!  Pagherai!\""

#. putstr
#: src/shk.c:5452
msgid "Fine goods for sale:"
msgstr "Merce pregiata in vendita:"

#: src/shk.c:5798 src/shk.c:5805
msgid "Your credit is erased."
msgstr "Il tuo credito è azzerato."

#: src/shk.c:6138
msgid "\"You set it, you buy it!\""
msgstr "\"Chi lo innesca, lo paga!\""

#: src/sit.c:28
msgid "You feel a strange sensation."
msgstr "Avverti una strana sensazione."

#. You_feel variant, selected when Unaware
#: src/sit.c:28
msgid "You dream that you feel a strange sensation."
msgstr "Sogni di avvertire una strana sensazione."

#: src/sit.c:30
msgid "You notice you have no gold!"
msgstr "Ti accorgi di non avere più oro!"

#: src/sit.c:84
msgid "You feel much, much better!"
msgstr "Ti senti molto, molto meglio!"

#. You_feel variant, selected when Unaware
#: src/sit.c:84
msgid "You dream that you feel much, much better!"
msgstr "Sogni di sentirti molto, molto meglio!"

#: src/sit.c:107
msgid "You feel your luck is changing."
msgstr "Senti che la tua fortuna sta cambiando."

#. You_feel variant, selected when Unaware
#: src/sit.c:107
msgid "You dream that you feel your luck is changing."
msgstr "Sogni di sentire che la tua fortuna sta cambiando."

#: src/sit.c:117 src/sit.c:127 src/sit.c:135
msgid "A voice echoes:"
msgstr "Una voce echeggia:"

#: src/sit.c:138
msgid "\"A curse upon thee for sitting upon this most holy throne!\""
msgstr ""
"\"Una maledizione su di te per aver osato sederti su questo santissimo "
"trono!\""

#: src/sit.c:148
msgid "A terrible drone fills your head!"
msgstr "Un terribile ronzio ti riempie la testa!"

#: src/sit.c:152
msgid "An image forms in your mind."
msgstr "Un'immagine si forma nella tua mente."

#: src/sit.c:158
msgid "Your vision becomes clear."
msgstr "La tua vista si schiarisce."

#: src/sit.c:187 src/spell.c:142
msgid "You feel threatened."
msgstr "Avverti una minaccia."

#. You_feel variant, selected when Unaware
#: src/sit.c:187 src/spell.c:142
msgid "You dream that you feel threatened."
msgstr "Sogni di avvertire una minaccia."

#: src/sit.c:190 src/spell.c:138 src/teleport.c:1511 src/teleport.c:1560
msgid "You feel a wrenching sensation."
msgstr "Avverti una sensazione di strappo."

#. You_feel variant, selected when Unaware
#: src/sit.c:190 src/spell.c:138 src/teleport.c:1511 src/teleport.c:1560
msgid "You dream that you feel a wrenching sensation."
msgstr "Sogni di avvertire una sensazione di strappo."

#: src/sit.c:195
msgid "You are granted an insight!"
msgstr "Ti viene concessa un'illuminazione!"

# JOKE: mind into pretzel
#: src/sit.c:202
msgid "Your mind turns into a pretzel!"
msgstr "La tua mente si attorciglia come un pretzel!"

#: src/sit.c:212
msgid "You feel very comfortable here."
msgstr "Ti senti a tuo agio qui."

#. You_feel variant, selected when Unaware
#: src/sit.c:212
msgid "You dream that you feel very comfortable here."
msgstr "Sogni di sentirti a tuo agio qui."

#: src/sit.c:214
msgid "You feel somehow out of place..."
msgstr "Ti senti in qualche modo fuori posto..."

#. You_feel variant, selected when Unaware
#: src/sit.c:214
msgid "You dream that you feel somehow out of place..."
msgstr "Sogni di sentirti in qualche modo fuori posto..."

#: src/sit.c:255
msgid "The throne disintegrates, having spent its power."
msgstr "Il trono si disintegra, avendo esaurito il suo potere."

#: src/sit.c:259
msgid "Sitting on the throne was a terrible experience."
msgstr "Sederti sul trono è stata un'esperienza terribile."

#: src/sit.c:273
msgid "A greasy liquid sprays all over you!"
msgstr "Un liquido untuoso ti schizza addosso!"

#: src/sit.c:284
msgid "The throne somehow seems to be amused."
msgstr "In qualche modo il trono sembra divertito."

#: src/sit.c:293
msgid "You feel extremely disoriented for a moment."
msgstr "Per un attimo perdi completamente l'orientamento."

#. You_feel variant, selected when Unaware
#: src/sit.c:293
msgid "You dream that you feel extremely disoriented for a moment."
msgstr "Sogni di perdere completamente l'orientamento per un attimo."

#: src/sit.c:304
msgid "The throne seeems to be calling for help!"
msgstr "Il trono sembra chiamare aiuto!"

#: src/sit.c:331
msgid "This throne was not meant for those such as you!"
msgstr "Questo trono non è fatto per quelli come te!"

#: src/sit.c:332 src/trap.c:2505
msgid "You feel a change coming over you."
msgstr "Senti un cambiamento impadronirsi di te."

#. You_feel variant, selected when Unaware
#: src/sit.c:332 src/trap.c:2505
msgid "You dream that you feel a change coming over you."
msgstr "Sogni di sentire un cambiamento impadronirsi di te."

#: src/sit.c:338
msgid "The throne is covered in acid!"
msgstr "Il trono è coperto di acido!"

#: src/sit.c:347
msgid "As you sit on the throne, your body and mind start to warp."
msgstr ""
"Mentre ti siedi sul trono, il tuo corpo e la tua mente iniziano a "
"distorcersi."

#: src/sit.c:369
msgid "You don't have enough energy to lay an egg."
msgstr "Non hai abbastanza energia per deporre un uovo."

# JOKE: Yoda-style splash tetra
#: src/sit.c:373
msgid "A splash tetra you are not."
msgstr "Un tetra spruzzatore, tu non sei."

#: src/sit.c:379
msgid "You yearn for the Sargasso Sea."
msgstr "Brami il Mar dei Sargassi."

#: src/sit.c:416
msgid "There are no seats in here!"
msgstr "Qui dentro non ci sono posti a sedere!"

#: src/sit.c:420
msgid "You are sitting on air."
msgstr "Stai sedendo sull'aria."

#: src/sit.c:448
msgid "It's probably not a good time for a picnic..."
msgstr "Forse non è il momento giusto per un picnic..."

#: src/sit.c:455
msgid "It's squishy..."
msgstr "È molliccio..."

#: src/sit.c:459
msgid "Squelch!"
msgstr "Splat!"

#: src/sit.c:464
msgid "It's not very comfortable..."
msgstr "Non è molto comodo..."

#: src/sit.c:475
msgid "You sit down on a spike.  Ouch!"
msgstr "Ti siedi su una punta acuminata.  Ahi!"

#: src/sit.c:480
msgid "You sit down in the pit."
msgstr "Ti siedi nella fossa."

#: src/sit.c:483
msgid "You sit in the spider web and get entangled further!"
msgstr "Ti siedi nella ragnatela e ti impigli ancora di più!"

#: src/sit.c:495
msgid "You can't maneuver to sit!"
msgstr "Non riesci a manovrare per sederti!"

#: src/sit.c:508
msgid "There are no cushions floating nearby."
msgstr "Non ci sono cuscini che galleggiano nelle vicinanze."

#: src/sit.c:510
msgid "You sit down on the muddy bottom."
msgstr "Ti siedi sul fondo fangoso."

#: src/sit.c:553
msgid "The ice feels cold."
msgstr "Il ghiaccio è freddo."

#: src/sit.c:652
msgid "You feel warmer."
msgstr "Senti più caldo."

#. You_feel variant, selected when Unaware
#: src/sit.c:652
msgid "You dream that you feel warmer."
msgstr "Sogni di sentire più caldo."

#: src/sit.c:661
msgid "You feel less jumpy."
msgstr "Senti calare l'agitazione."

#. You_feel variant, selected when Unaware
#: src/sit.c:661
msgid "You dream that you feel less jumpy."
msgstr "Sogni di sentire calare l'agitazione."

#: src/sit.c:670
msgid "You feel a little sick!"
msgstr "Ti senti poco bene!"

#. You_feel variant, selected when Unaware
#: src/sit.c:670
msgid "You dream that you feel a little sick!"
msgstr "Sogni di sentirti poco bene!"

#: src/sit.c:681
msgid "Your senses fail!"
msgstr "I sensi ti vengono meno!"

#: src/sit.c:690
msgid "You feel cooler."
msgstr "Senti più freddo."

#. You_feel variant, selected when Unaware
#: src/sit.c:690
msgid "You dream that you feel cooler."
msgstr "Sogni di sentire più freddo."

#: src/sit.c:699
msgid "You feel paranoid."
msgstr "Ti senti in preda alla paranoia."

#. You_feel variant, selected when Unaware
#: src/sit.c:699
msgid "You dream that you feel paranoid."
msgstr "Sogni di sentirti in preda alla paranoia."

#: src/sit.c:724
msgid "You feel slower."
msgstr "Ti senti rallentare."

#. You_feel variant, selected when Unaware
#: src/sit.c:724
msgid "You dream that you feel slower."
msgstr "Sogni di sentirti rallentare."

#: src/sit.c:733
msgid "You feel clumsy."
msgstr "Senti i tuoi movimenti farsi goffi."

#. You_feel variant, selected when Unaware
#: src/sit.c:733
msgid "You dream that you feel clumsy."
msgstr "Sogni di sentire i tuoi movimenti farsi goffi."

#: src/sit.c:743
msgid "You feel vulnerable."
msgstr "Ti senti vulnerabile."

#. You_feel variant, selected when Unaware
#: src/sit.c:743
msgid "You dream that you feel vulnerable."
msgstr "Sogni di sentirti vulnerabile."

#: src/sit.c:752
msgid "You feel less attractive."
msgstr "Ti senti meno attraente."

#. You_feel variant, selected when Unaware
#: src/sit.c:752
msgid "You dream that you feel less attractive."
msgstr "Sogni di sentirti meno attraente."

# fragment completing "You hear ..." (Senti ...)
#: src/sounds.c:52
msgid "the tones of courtly conversation."
msgstr "il tono di una conversazione di corte."

# fragment completing "You hear ..." (Senti ...)
#: src/sounds.c:52
msgid "a sceptre pounded in judgment."
msgstr "uno scettro battuto in segno di giudizio."

# fragment completing "You hear ..." (Senti ...)
#: src/sounds.c:52
msgid "Queen Beruthiel's cats!"
msgstr "i gatti della regina Beruthiel!"

#: src/sounds.c:75
msgid "You hear an angry drone."
msgstr "Senti un ronzio irato."

#. You_hear variant, selected when Underwater
#: src/sounds.c:75
msgid "You barely hear an angry drone."
msgstr "Senti a malapena un ronzio irato."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/sounds.c:75
msgid "You dream that you hear an angry drone."
msgstr "Sogni di sentire un ronzio irato."

#: src/sounds.c:98
msgid "You suddenly realize it is unnaturally quiet."
msgstr "Ti accorgi all'improvviso che c'è un silenzio innaturale."

#: src/sounds.c:256
msgid "You hear someone counting gold coins."
msgstr "Senti qualcuno contare monete d'oro."

#. You_hear variant, selected when Underwater
#: src/sounds.c:256
msgid "You barely hear someone counting gold coins."
msgstr "Senti a malapena qualcuno contare monete d'oro."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/sounds.c:256
msgid "You dream that you hear someone counting gold coins."
msgstr "Sogni di sentire qualcuno contare monete d'oro."

#: src/sounds.c:256
msgid "You hear the quarterback calling the play."
msgstr "Senti il quarterback chiamare lo schema."

#. You_hear variant, selected when Underwater
#: src/sounds.c:256
msgid "You barely hear the quarterback calling the play."
msgstr "Senti a malapena il quarterback chiamare lo schema."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/sounds.c:256
msgid "You dream that you hear the quarterback calling the play."
msgstr "Sogni di sentire il quarterback chiamare lo schema."

#: src/sounds.c:261
msgid "You hear someone searching."
msgstr "Senti qualcuno che cerca."

#. You_hear variant, selected when Underwater
#: src/sounds.c:261
msgid "You barely hear someone searching."
msgstr "Senti a malapena qualcuno che cerca."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/sounds.c:261
msgid "You dream that you hear someone searching."
msgstr "Sogni di sentire qualcuno che cerca."

#: src/sounds.c:270
msgid "You hear the footsteps of a guard on patrol."
msgstr "Senti i passi di una guardia in ronda."

#. You_hear variant, selected when Underwater
#: src/sounds.c:270
msgid "You barely hear the footsteps of a guard on patrol."
msgstr "Senti a malapena i passi di una guardia in ronda."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/sounds.c:270
msgid "You dream that you hear the footsteps of a guard on patrol."
msgstr "Sogni di sentire i passi di una guardia in ronda."

#: src/sounds.c:273
msgid "You hear Ebenezer Scrooge!"
msgstr "Senti Ebenezer Scrooge!"

#. You_hear variant, selected when Underwater
#: src/sounds.c:273
msgid "You barely hear Ebenezer Scrooge!"
msgstr "Senti a malapena Ebenezer Scrooge!"

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/sounds.c:273
msgid "You dream that you hear Ebenezer Scrooge!"
msgstr "Sogni di sentire Ebenezer Scrooge!"

#: src/sounds.c:532
msgid "\"I'm hungry.\""
msgstr "\"Ho fame.\""

#: src/sounds.c:973
msgid "You freeze for a moment."
msgstr "Ti blocchi per un istante."

#: src/sounds.c:1271
msgid "You can't speak.  You're choking!"
msgstr "Non puoi parlare.  Stai soffocando!"

#: src/sounds.c:1275
msgid "They won't hear you out there."
msgstr "Là fuori non ti sentiranno."

#: src/sounds.c:1279
msgid "Your speech is unintelligible underwater."
msgstr "Sott'acqua le tue parole sono incomprensibili."

#: src/sounds.c:1323
msgid "Talking to yourself is a bad habit for a dungeoneer."
msgstr "Parlare da soli è una brutta abitudine per un esploratore di dungeon."

#: src/sounds.c:1354
msgid "It's like talking to a wall."
msgstr "È come parlare a un muro."

#: src/sounds.c:1462
msgid "The lout here doesn't acknowledge you..."
msgstr "Lo zoticone qui non ti degna di attenzione..."

#: src/spell.c:152
msgid "These runes were just too much to comprehend."
msgstr "Queste rune erano troppo difficili da comprendere."

#: src/spell.c:156
msgid "The book was coated with contact poison!"
msgstr "Il libro era ricoperto di veleno da contatto!"

#: src/spell.c:196
msgid "Being confused you have difficulties in controlling your actions."
msgstr "In stato confusionale hai difficoltà a controllare le tue azioni."

#: src/spell.c:198
msgid "You accidentally tear the spellbook to pieces."
msgstr "Strappi accidentalmente il libro di incantesimi a pezzi."

#: src/spell.c:236
msgid "You turn the pages of the Book of the Dead..."
msgstr "Sfogli le pagine del Libro dei Morti..."

#: src/spell.c:257
msgid "You hear a faint chime..."
msgstr "Senti un debole rintocco..."

#. You_hear variant, selected when Underwater
#: src/spell.c:257
msgid "You barely hear a faint chime..."
msgstr "Senti a malapena un debole rintocco..."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/spell.c:257
msgid "You dream that you hear a faint chime..."
msgstr "Sogni di sentire un debole rintocco..."

#: src/spell.c:260
msgid "Vlad's doppelganger is amused."
msgstr "Il doppelganger di Vlad è divertito."

#: src/spell.c:282
msgid "The invocation fails!"
msgstr "L'invocazione fallisce!"

#: src/spell.c:285
msgid "At least one of your relics is cursed..."
msgstr "Almeno una delle tue reliquie è maledetta..."

#: src/spell.c:309
msgid "You raised the dead!"
msgstr "Hai risvegliato i morti!"

#: src/spell.c:329
msgid "Your ancestors are annoyed with you!"
msgstr "I tuoi antenati sono irritati con te!"

#: src/spell.c:332
msgid "The headstones in the cemetery begin to move!"
msgstr "Le lapidi del cimitero iniziano a muoversi!"

#: src/spell.c:335
msgid "Oh my!  Your name appears in the book!"
msgstr "Oh cielo!  Il tuo nome appare nel libro!"

#: src/spell.c:402
msgid "This spellbook is too faint to be read any more."
msgstr "Questo libro di incantesimi è troppo sbiadito per essere letto ancora."

#: src/spell.c:420
msgid "This spellbook is too faint to read even once."
msgstr ""
"Questo libro di incantesimi è troppo sbiadito per essere letto anche solo "
"una volta."

#: src/spell.c:507
msgid "This spellbook is all blank."
msgstr "Questo libro di incantesimi è tutto bianco."

#. prompt
#: src/spell.c:571
msgid "Refresh your memory anyway?"
msgstr "Rinfrescare comunque la memoria?"

#: src/spell.c:614
msgid "The spellbook crumbles to dust!"
msgstr "Il libro di incantesimi si sbriciola in polvere!"

#: src/spell.c:691
msgid "You are too impaired to cast a spell."
msgstr "Le tue condizioni ti impediscono di lanciare un incantesimo."

#: src/spell.c:694
msgid "You are unable to chant the incantation."
msgstr "Non riesci a recitare la formula magica."

#: src/spell.c:704
msgid "Your arms are not free to cast!"
msgstr "Non hai le braccia libere per lanciare incantesimi!"

#: src/spell.c:723 src/spell.c:2028
msgid "You don't know any spells right now."
msgstr "Al momento non conosci nessun incantesimo."

#: src/spell.c:774
msgid "You don't know that spell."
msgstr "Non conosci quell'incantesimo."

#: src/spell.c:1175
msgid "Your skin feels warm for a moment."
msgstr "Per un istante senti la pelle calda."

#: src/spell.c:1252
msgid "Your knowledge of this spell is twisted."
msgstr "La tua conoscenza di questo incantesimo è distorta."

#: src/spell.c:1253
msgid "It invokes nightmarish images in your mind..."
msgstr "Evoca nella tua mente immagini da incubo..."

#: src/spell.c:1262
msgid "You strain to recall the spell."
msgstr "Ti sforzi di ricordare l'incantesimo."

#: src/spell.c:1264
msgid "You have difficulty remembering the spell."
msgstr "Fai fatica a ricordare l'incantesimo."

#: src/spell.c:1266
msgid "Your knowledge of this spell is growing faint."
msgstr "La tua conoscenza di questo incantesimo si sta affievolendo."

#: src/spell.c:1268
msgid "Your recall of this spell is gradually fading."
msgstr "Il tuo ricordo di questo incantesimo sta sfumando a poco a poco."

#: src/spell.c:1272
msgid "You are too hungry to cast that spell."
msgstr "Hai troppa fame per lanciare quell'incantesimo."

#: src/spell.c:1276
msgid "You lack the strength to cast spells."
msgstr "Ti manca la forza per lanciare incantesimi."

#: src/spell.c:1291
msgid "You feel the amulet draining your energy away."
msgstr "Senti l'amuleto che ti prosciuga l'energia."

#. You_feel variant, selected when Unaware
#: src/spell.c:1291
msgid "You dream that you feel the amulet draining your energy away."
msgstr "Sogni di sentire l'amuleto che ti prosciuga l'energia."

#: src/spell.c:1373
msgid "You fail to cast the spell correctly."
msgstr "Non riesci a lanciare correttamente l'incantesimo."

#: src/spell.c:1498
msgid "The magical energy is released!"
msgstr "L'energia magica viene rilasciata!"

# JOKE: in this weather
#: src/spell.c:1661
msgid "You're joking!  In this weather?"
msgstr "Scherzi?  Con questo tempo?"

#: src/spell.c:1664
msgid "You had better wait for the sun to come out."
msgstr "Faresti meglio ad aspettare che esca il sole."

#: src/spell.c:1668
msgid "Where do you want to cast the spell?"
msgstr "Dove vuoi lanciare l'incantesimo?"

#: src/spell.c:1679
msgid "The spell dissipates over the distance!"
msgstr "L'incantesimo si dissolve per la distanza!"

#: src/spell.c:1682
msgid "The spell is cut short!"
msgstr "L'incantesimo viene interrotto!"

#: src/spell.c:1690
msgid "Your mind fails to lock onto that location!"
msgstr "La tua mente non riesce ad agganciare quel luogo!"

#. menu
#: src/spell.c:1999
msgid "by casting letter"
msgstr "per lettera di lancio"

#. menu
#: src/spell.c:1999
msgid "alphabetically"
msgstr "in ordine alfabetico"

#. menu
#: src/spell.c:1999
msgid "by level, low to high"
msgstr "per livello, dal più basso al più alto"

#. menu
#: src/spell.c:1999
msgid "by level, high to low"
msgstr "per livello, dal più alto al più basso"

#. menu
#: src/spell.c:1999
msgid "by skill group, alphabetized within each group"
msgstr "per gruppo di abilità, in ordine alfabetico entro ogni gruppo"

#. menu
