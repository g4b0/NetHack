msgstr "riassegna le lettere di lancio per mantenere l'ordine attuale"

#: src/spell.c:2063
msgid "You didn't know any spells."
msgstr "Non conoscevi nessun incantesimo."

#: src/spell.c:2066
msgid "Spells:"
msgstr "Incantesimi:"

#. menu
#: src/spell.c:2142
msgid "[sort spells]"
msgstr "[ordina incantesimi]"

#: src/steal.c:110
msgid "Your purse feels lighter."
msgstr "La tua borsa sembra più leggera."

#: src/steal.c:392
msgid "Somebody tries to rob you, but finds nothing to steal."
msgstr "Qualcuno tenta di derubarti, ma non trova nulla da rubare."

#: src/steed.c:51
msgid "Saddle yourself?  Very funny..."
msgstr "Sellarti?  Molto divertente..."

#: src/steed.c:56 src/steed.c:257
msgid "I see nobody there."
msgstr "Non vedo nessuno lì."

#: src/steed.c:78
msgid "Shame on you!"
msgstr "Vergognati!"

#: src/steed.c:88
msgid "You can't saddle such a creature."
msgstr "Non puoi sellare una creatura simile."

#: src/steed.c:213
msgid "Maybe you should find a designated driver."
msgstr "Forse dovresti trovare un guidatore designato."

#: src/steed.c:245
msgid "You won't fit on a saddle."
msgstr "Non c'è posto per te su una sella."

#: src/steed.c:276
msgid "You are stuck here for now."
msgstr "Per ora non puoi muoverti da qui."

#: src/steed.c:323
msgid "You can't ride such a creature."
msgstr "Non puoi cavalcare una creatura simile."

#: src/steed.c:330
#, c-format
msgid "You cannot reach %s."
msgstr "Non riesci a raggiungere %s."

#: src/steed.c:377
msgid "You aren't stealthy anymore."
msgstr "Non passi più inosservato."

#: src/steed.c:641
msgid "You can't.  There isn't anywhere for you to stand."
msgstr "Non puoi.  Non c'è nessun posto dove metterti in piedi."

#: src/steed.c:648
msgid "It felt good to get out of the rain."
msgstr "È stato bello uscire dalla pioggia."

#: src/steed.c:665
msgid "You seem less noisy now."
msgstr "Ora fai meno rumore."

#. menu
#: src/symbols.c:1063
msgid "Default Symbols"
msgstr "Simboli predefiniti"

#: src/teleport.c:855
msgid "A mysterious force prevents you from teleporting!"
msgstr "Una forza misteriosa ti impedisce di teletrasportarti!"

#: src/teleport.c:866
msgid "You feel disoriented for a moment."
msgstr "Per un attimo perdi l'orientamento."

#. You_feel variant, selected when Unaware
#: src/teleport.c:866
msgid "You dream that you feel disoriented for a moment."
msgstr "Sogni di perdere l'orientamento per un attimo."

#: src/teleport.c:875
msgid "Being unconscious, you cannot control your teleport."
msgstr "In stato di incoscienza non puoi controllare il tuo teletrasporto."

#: src/teleport.c:903 src/teleport.c:1414
msgid "Sorry..."
msgstr "Spiacente..."

#. prompt
#: src/teleport.c:1047
msgid "There is a level teleporter here. Trigger it?"
msgstr "C'è un teletrasporto di livello qui. Attivarlo?"

#: src/teleport.c:1057
msgid "This is a vault teleport, usable once only."
msgstr "Questo è un teletrasporto per il caveau, utilizzabile una sola volta."

#. prompt
#: src/teleport.c:1058
msgid "Jump in?"
msgstr "Saltarci dentro?"

#: src/teleport.c:1217
msgid "Oops..."
msgstr "Ops..."

#. prompt
#: src/teleport.c:1263
msgid "Go to Nowhere.  Are you sure?"
msgstr "Andare in Nessun Luogo.  Confermi?"

#: src/teleport.c:1268
msgid "You cease to exist."
msgstr "Cessi di esistere."

#: src/teleport.c:1275
msgid "An energized cloud of dust begins to coalesce."
msgstr "Una nube di polvere energizzata comincia ad aggregarsi."

#: src/teleport.c:1341
msgid "You arrive in heaven."
msgstr "Arrivi in paradiso."

#: src/teleport.c:1343
msgid "\"Thou art early, but we'll admit thee.\""
msgstr "\"Sei in anticipo, ma ti accoglieremo.\""

#: src/teleport.c:1347
msgid "You feel deliriously happy."
msgstr "Ti senti follemente felice."

#. You_feel variant, selected when Unaware
#: src/teleport.c:1347
msgid "You dream that you feel deliriously happy."
msgstr "Sogni di sentirti follemente felice."

# JOKE: Cloud 9 pun
#: src/teleport.c:1348
msgid "(In fact, you're on Cloud 9!)"
msgstr "(In effetti, sei al settimo cielo!)"

#: src/teleport.c:1351
msgid "You are now high above the clouds..."
msgstr "Ora ti trovi molto in alto sopra le nuvole..."

#: src/teleport.c:1360
msgid "Unfortunately, you don't know how to fly."
msgstr "Purtroppo non sai volare."

#: src/teleport.c:1361
msgid "You plummet a few thousand feet to your death."
msgstr "Precipiti per qualche migliaio di piedi verso la morte."

#: src/teleport.c:1469
msgid "You activated a magic portal!"
msgstr "Hai attivato un portale magico!"

#: src/teleport.c:1476
msgid "You feel dizzy for a moment, but nothing happens..."
msgstr "Hai un capogiro per un attimo, ma non succede nulla..."

#. You_feel variant, selected when Unaware
#: src/teleport.c:1476
msgid "You dream that you feel dizzy for a moment, but nothing happens..."
msgstr "Sogni di avere un capogiro per un attimo, ma non succede nulla..."

#: src/timeout.c:301
msgid "Your blood is having trouble reaching your brain."
msgstr "Il sangue fatica ad arrivarti al cervello."

#: src/timeout.c:301
msgid "Your consciousness is fading."
msgstr "La tua coscienza sta svanendo."

#: src/timeout.c:301
msgid "You suffocate."
msgstr "Soffochi."

#: src/timeout.c:695
msgid "You have recovered from your illness."
msgstr "La malattia è passata."

#: src/timeout.c:701
msgid "You die from your illness."
msgstr "Muori a causa della malattia."

#: src/timeout.c:760
msgid "You are no longer invisible."
msgstr "Non sei più invisibile."

#: src/timeout.c:760
msgid "You can no longer see through yourself."
msgstr "Non riesci più a vedere attraverso di te."

#: src/timeout.c:807
msgid "You land."
msgstr "Atterri."

#: src/timeout.c:821
msgid "You no longer feel safe from acid."
msgstr "Non ti senti più al sicuro dall'acido."

#: src/timeout.c:834
msgid "You no longer feel secure from petrification."
msgstr "Non ti senti più al riparo dalla pietrificazione."

#: src/timeout.c:849
msgid "Your temporary ability to survive burning has ended."
msgstr "La tua capacità temporanea di sopravvivere alle fiamme è finita."

#: src/timeout.c:854
msgid "Your temporary ability to walk on liquid has ended."
msgstr "La tua capacità temporanea di camminare sui liquidi è finita."

#: src/timeout.c:875
msgid "You feel hemmed in again."
msgstr "Ti senti di nuovo in gabbia."

#. You_feel variant, selected when Unaware
#: src/timeout.c:875
msgid "You dream that you feel hemmed in again."
msgstr "Sogni di sentirti di nuovo in gabbia."

#: src/timeout.c:914
msgid "You make a lot of noise!"
msgstr "Fai molto rumore!"

#: src/timeout.c:1283
msgid "You lose your balance."
msgstr "Perdi l'equilibrio."

#: src/timeout.c:1310
msgid "You flounder."
msgstr "Annaspi."

#: src/timeout.c:1313
msgid "You stumble."
msgstr "Inciampi."

#: src/timeout.c:1327
msgid "You let go of the reins."
msgstr "Lasci andare le redini."

#: src/timeout.c:1330
msgid "You bang into the saddle-horn."
msgstr "Sbatti contro il pomello della sella."

#: src/timeout.c:1333
msgid "You slide to one side of the saddle."
msgstr "Scivoli su un lato della sella."

#: src/timeout.c:1363
msgid "Your lantern is getting dim."
msgstr "La tua lanterna si sta affievolendo."

#: src/timeout.c:1365
msgid "Batteries have not been invented yet."
msgstr "Le batterie non sono ancora state inventate."

#: src/timeout.c:1368
msgid "You see a lantern getting dim."
msgstr "Vedi una lanterna che si affievolisce."

#. You_see variant, selected when Unaware
#: src/timeout.c:1368
msgid "You dream that you see a lantern getting dim."
msgstr "Sogni di vedere una lanterna che si affievolisce."

#. You_see variant, selected when Blind (and not Unaware)
#: src/timeout.c:1368
msgid "You sense a lantern getting dim."
msgstr "Percepisci una lanterna che si affievolisce."

#: src/timeout.c:1453
msgid "You see a burning potion of oil go out."
msgstr "Vedi una pozione d'olio accesa spegnersi."

#. You_see variant, selected when Unaware
#: src/timeout.c:1453
msgid "You dream that you see a burning potion of oil go out."
msgstr "Sogni di vedere una pozione d'olio accesa spegnersi."

#. You_see variant, selected when Blind (and not Unaware)
#: src/timeout.c:1453
msgid "You sense a burning potion of oil go out."
msgstr "Percepisci una pozione d'olio accesa spegnersi."

#: src/timeout.c:1521
msgid "You see a lantern run out of power."
msgstr "Vedi una lanterna esaurire l'energia."

#. You_see variant, selected when Unaware
#: src/timeout.c:1521
msgid "You dream that you see a lantern run out of power."
msgstr "Sogni di vedere una lanterna esaurire l'energia."

#. You_see variant, selected when Blind (and not Unaware)
#: src/timeout.c:1521
msgid "You sense a lantern run out of power."
msgstr "Percepisci una lanterna esaurire l'energia."

#: src/timeout.c:1625
msgid "They shriek!"
msgstr "Strillano!"

#: src/timeout.c:1625
msgid "It shrieks!"
msgstr "Strilla!"

#: src/timeout.c:1625
msgid "Their flames die."
msgstr "Le loro fiamme si spengono."

#: src/timeout.c:1625
msgid "Its flame dies."
msgstr "La sua fiamma si spegne."

#: src/timeout.c:1879
msgid "Kaboom!!!  Boom!!  Boom!!"
msgstr "Kabum!!!  Bum!!  Bum!!"

#: src/timeout.c:1889
msgid "You hear a rumbling noise."
msgstr "Senti un brontolio."

#. You_hear variant, selected when Underwater
#: src/timeout.c:1889
msgid "You barely hear a rumbling noise."
msgstr "Senti a malapena un brontolio."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/timeout.c:1889
msgid "You dream that you hear a rumbling noise."
msgstr "Sogni di sentire un brontolio."

#: src/trap.c:380
msgid "The grease dissolves."
msgstr "Il grasso si dissolve."

#: src/trap.c:626
msgid "A trap door opens up under you!"
msgstr "Una botola si apre sotto di te!"

#: src/trap.c:628
msgid "There's a gaping hole under you!"
msgstr "C'è un buco spalancato sotto di te!"

#: src/trap.c:652
msgid "The opening under you closes up."
msgstr "L'apertura sotto di te si richiude."

#: src/trap.c:1055
msgid "You can fly."
msgstr "Puoi volare."

#: src/trap.c:1204
msgid "You hear a loud click!"
msgstr "Senti un forte clic!"

#. You_hear variant, selected when Underwater
#: src/trap.c:1204
msgid "You barely hear a loud click!"
msgstr "Senti a malapena un forte clic!"

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/trap.c:1204
msgid "You dream that you hear a loud click!"
msgstr "Sogni di sentire un forte clic!"

#: src/trap.c:1211
msgid "An arrow shoots out at you!"
msgstr "Una freccia scatta verso di te!"

#: src/trap.c:1267
msgid "You hear a soft click."
msgstr "Senti un lieve clic."

#. You_hear variant, selected when Underwater
#: src/trap.c:1267
msgid "You barely hear a soft click."
msgstr "Senti a malapena un lieve clic."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/trap.c:1267
msgid "You dream that you hear a soft click."
msgstr "Sogni di sentire un lieve clic."

#: src/trap.c:1274
msgid "A little dart shoots out at you!"
msgstr "Un piccolo dardo scatta verso di te!"

#: src/trap.c:1365
msgid "It passes harmlessly through you."
msgstr "Ti attraversa senza farti male."

#: src/trap.c:1426
msgid "You notice a crease in the linoleum."
msgstr "Noti una piega nel linoleum."

#: src/trap.c:1428
msgid "You notice a loose board below you."
msgstr "Noti un'asse allentata sotto di te."

#: src/trap.c:1519
msgid "You howl in anger!"
msgstr "Ululi di rabbia!"

#: src/trap.c:1545
msgid "You hear the roaring of an angry bear!"
msgstr "Senti il ruggito di un orso infuriato!"

#. You_hear variant, selected when Underwater
#: src/trap.c:1545
msgid "You barely hear the roaring of an angry bear!"
msgstr "Senti a malapena il ruggito di un orso infuriato!"

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/trap.c:1545
msgid "You dream that you hear the roaring of an angry bear!"
msgstr "Sogni di sentire il ruggito di un orso infuriato!"

#: src/trap.c:1574
msgid "You are enveloped in a cloud of gas!"
msgstr "Una nuvola di gas ti avvolge!"

#: src/trap.c:1577
msgid "A cloud of gas puts you to sleep!"
msgstr "Una nuvola di gas ti fa addormentare!"

#: src/trap.c:1653
msgid "You are covered with rust!"
msgstr "La ruggine ti ricopre!"

#: src/trap.c:1813 src/trap.c:4581
msgid "You smell smoke."
msgstr "Senti odore di fumo."

#: src/trap.c:1885
msgid "You move into an adjacent pit."
msgstr "Ti sposti in una fossa adiacente."

# wumpus reference, bottomless pit
#: src/trap.c:1899
msgid "Fortunately it has a bottom after all..."
msgstr "Per fortuna, dopotutto, ha un fondo..."

# JOKE: pitiful / the pits
#: src/trap.c:1902 src/trap.c:2000
msgid "How pitiful.  Isn't that the pits?"
msgstr "Che pena.  Questo sì che è toccare il fondo, no?"

#: src/trap.c:2131
msgid "You take a walk on your web."
msgstr "Fai una passeggiata sulla tua ragnatela."

#: src/trap.c:2131
msgid "There is a spider web here."
msgstr "C'è una ragnatela qui."

#: src/trap.c:2224
msgid "You hear the roaring of a confused bear!"
msgstr "Senti il ruggito di un orso confuso!"

#. You_hear variant, selected when Underwater
#: src/trap.c:2224
msgid "You barely hear the roaring of a confused bear!"
msgstr "Senti a malapena il ruggito di un orso confuso!"

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/trap.c:2224
msgid "You dream that you hear the roaring of a confused bear!"
msgstr "Sogni di sentire il ruggito di un orso confuso!"

#: src/trap.c:2306
msgid "You are caught in a magical explosion!"
msgstr "Un'esplosione magica ti travolge!"

#: src/trap.c:2308
msgid "Your body absorbs some of the magical energy!"
msgstr "Il tuo corpo assorbe parte dell'energia magica!"

#: src/trap.c:2385
msgid "You feel unbearably torpid!"
msgstr "Provi un torpore insopportabile!"

#. You_feel variant, selected when Unaware
#: src/trap.c:2385
msgid "You dream that you feel unbearably torpid!"
msgstr "Sogni di provare un torpore insopportabile!"

#: src/trap.c:2385
msgid "You feel very lethargic."
msgstr "Provi un forte torpore."

#. You_feel variant, selected when Unaware
#: src/trap.c:2385
msgid "You dream that you feel very lethargic."
msgstr "Sogni di provare un forte torpore."

#: src/trap.c:2385
msgid "You feel sluggish."
msgstr "Provi un leggero torpore."

#. You_feel variant, selected when Unaware
#: src/trap.c:2385
msgid "You dream that you feel sluggish."
msgstr "Sogni di provare un leggero torpore."

#: src/trap.c:2689
msgid "No boulder was released."
msgstr "Nessun masso è stato rilasciato."

#: src/trap.c:2691
msgid "Fortunately for you, no boulder was released."
msgstr "Per tua fortuna, nessun masso è stato rilasciato."

#: src/trap.c:3336
msgid "You hear someone bowling."
msgstr "Senti qualcuno giocare a bowling."

#. You_hear variant, selected when Underwater
#: src/trap.c:3336
msgid "You barely hear someone bowling."
msgstr "Senti a malapena qualcuno giocare a bowling."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/trap.c:3336
msgid "You dream that you hear someone bowling."
msgstr "Sogni di sentire qualcuno giocare a bowling."

#: src/trap.c:3483
msgid "Suddenly the rolling boulder disappears!"
msgstr "All'improvviso il masso rotolante scompare!"

#: src/trap.c:3485
msgid "You hear a rumbling stop abruptly."
msgstr "Senti un rombo interrompersi bruscamente."

#. You_hear variant, selected when Underwater
#: src/trap.c:3485
msgid "You barely hear a rumbling stop abruptly."
msgstr "Senti a malapena un rombo interrompersi bruscamente."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/trap.c:3485
msgid "You dream that you hear a rumbling stop abruptly."
msgstr "Sogni di sentire un rombo interrompersi bruscamente."

#: src/trap.c:3547
msgid "The boulder crashes through a door."
msgstr "Il masso sfonda una porta."

#: src/trap.c:3995
msgid "Up, up, and awaaaay!  You're walking on air!"
msgstr "Su, su, e viaaaa!  Cammini sull'aria!"

#: src/trap.c:3997
msgid "You gain control over your movements."
msgstr "Prendi il controllo dei tuoi movimenti."

#: src/trap.c:3999
msgid "You start to float in the air!"
msgstr "Inizi a fluttuare nell'aria!"

#: src/trap.c:4011
msgid "You are no longer able to control your flight."
msgstr "Non riesci più a controllare il tuo volo."

#: src/trap.c:4072
msgid "You have stopped levitating and are now flying."
msgstr "Hai smesso di levitare e ora voli."

#: src/trap.c:4126
msgid "You begin to tumble in place."
msgstr "Inizi a ruzzolare sul posto."

#: src/trap.c:4128
msgid "You feel heavier."
msgstr "Ti senti più pesante."

#. You_feel variant, selected when Unaware
#: src/trap.c:4128
msgid "You dream that you feel heavier."
msgstr "Sogni di sentirti più pesante."

#: src/trap.c:4139
msgid "Bummer!  You've crashed."
msgstr "Accidenti!  Che schianto."

#: src/trap.c:4141
msgid "You fall over."
msgstr "Cadi a terra."

#: src/trap.c:4148
msgid "You settle more firmly in the saddle."
msgstr "Ti assesti più saldamente in sella."

# GENDER
# JOKE: help, fallen, can't get up
#: src/trap.c:4237
msgid "You've fallen, and you can't get up."
msgstr "Sei caduto e non riesci ad alzarti."

#: src/trap.c:4237
msgid "You are still in a pit."
msgstr "Sei ancora in una fossa."

#: src/trap.c:4259 src/trap.c:4312
msgid "You are uninjured."
msgstr "Non subisci danni."

#: src/trap.c:4322
msgid "You smell paper burning."
msgstr "Senti odore di carta bruciata."

#: src/trap.c:4340
msgid "You are momentarily blinded by a flash of light!"
msgstr "Un lampo di luce ti acceca per un istante!"

#: src/trap.c:4345
msgid "You see a flash of light!"
msgstr "Vedi un lampo di luce!"

#. You_see variant, selected when Unaware
#: src/trap.c:4345
msgid "You dream that you see a flash of light!"
msgstr "Sogni di vedere un lampo di luce!"

#. You_see variant, selected when Blind (and not Unaware)
#: src/trap.c:4345
msgid "You sense a flash of light!"
msgstr "Percepisci un lampo di luce!"

#: src/trap.c:4351
msgid "You hear a deafening roar!"
msgstr "Senti un ruggito assordante!"

#. You_hear variant, selected when Underwater
#: src/trap.c:4351
msgid "You barely hear a deafening roar!"
msgstr "Senti a malapena un ruggito assordante!"

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/trap.c:4351
msgid "You dream that you hear a deafening roar!"
msgstr "Sogni di sentire un ruggito assordante!"

#: src/trap.c:4356
msgid "You feel rankled."
msgstr "Provi un senso di irritazione."

#. You_feel variant, selected when Unaware
#: src/trap.c:4356
msgid "You dream that you feel rankled."
msgstr "Sogni di provare un senso di irritazione."

#: src/trap.c:4372
msgid "You hear a low hum."
msgstr "Senti un sordo ronzio."

#. You_hear variant, selected when Underwater
#: src/trap.c:4372
msgid "You barely hear a low hum."
msgstr "Senti a malapena un sordo ronzio."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/trap.c:4372
msgid "You dream that you hear a low hum."
msgstr "Sogni di sentire un sordo ronzio."

#: src/trap.c:4379
msgid "You can see yourself again!"
msgstr "Torni a vederti!"

#: src/trap.c:4381
msgid "You can't see through yourself anymore."
msgstr "Non vedi più attraverso il tuo corpo."

#: src/trap.c:4400
msgid "You hear the moon howling at you."
msgstr "Senti la luna che ulula verso di te."

#. You_hear variant, selected when Underwater
#: src/trap.c:4400
msgid "You barely hear the moon howling at you."
msgstr "Senti a malapena la luna che ulula verso di te."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/trap.c:4400
msgid "You dream that you hear the moon howling at you."
msgstr "Sogni di sentire la luna che ulula verso di te."

#: src/trap.c:4400
msgid "You hear distant howling."
msgstr "Senti un ululato lontano."

#. You_hear variant, selected when Underwater
#: src/trap.c:4400
msgid "You barely hear distant howling."
msgstr "Senti a malapena un ululato lontano."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/trap.c:4400
msgid "You dream that you hear distant howling."
msgstr "Sogni di sentire un ululato lontano."

#: src/trap.c:4419
msgid "Your pack shakes violently!"
msgstr "Il tuo zaino trema violentemente!"

#: src/trap.c:4422
msgid "You smell hamburgers."
msgstr "Senti odore di hamburger."

#: src/trap.c:4422
msgid "You smell charred flesh."
msgstr "Senti odore di carne bruciata."

#: src/trap.c:4425
msgid "You feel tired."
msgstr "Ti senti senza forze."

#. You_feel variant, selected when Unaware
#: src/trap.c:4425
msgid "You dream that you feel tired."
msgstr "Sogni di sentirti senza forze."

#: src/trap.c:4507
msgid "Its contents fall out."
msgstr "Il contenuto cade fuori."

#: src/trap.c:5102 src/uhitm.c:2306
msgid "You rust!"
msgstr "Arrugginisci!"

#: src/trap.c:5120
msgid "But you aren't drowning."
msgstr "Ma non stai annegando."

#: src/trap.c:5123
msgid "Your keel hits the bottom."
msgstr "La tua chiglia tocca il fondo."

#: src/trap.c:5125
msgid "You touch bottom."
msgstr "Tocchi il fondo."

#: src/trap.c:5140
msgid "You attempt a teleport spell."
msgstr "Tenti un incantesimo di teletrasporto."

#: src/trap.c:5146
msgid "The attempted teleport spell fails."
msgstr "L'incantesimo di teletrasporto fallisce."

#: src/trap.c:5172
msgid "You dump some of your gear to lose weight..."
msgstr "Getti via parte del tuo equipaggiamento per alleggerirti..."

#: src/trap.c:5174
msgid "Pheew!  That was close."
msgstr "Uff!  C'è mancato poco."

#: src/trap.c:5179
msgid "But in vain."
msgstr "Ma invano."

#: src/trap.c:5182
msgid "You drown."
msgstr "Anneghi."

#: src/trap.c:5203
msgid "You're still drowning."
msgstr "Stai ancora annegando."

#: src/trap.c:5493
msgid "Whoops..."
msgstr "Ops..."

#: src/trap.c:5513
msgid "The web sticks to you.  You're caught too!"
msgstr "La ragnatela si attacca a te.  Anche tu sei in trappola!"

#: src/trap.c:5556
msgid "You feel that you did the right thing."
msgstr "Senti di aver fatto la cosa giusta."

#. You_feel variant, selected when Unaware
#: src/trap.c:5556
msgid "You dream that you feel that you did the right thing."
msgstr "Sogni di sentire di aver fatto la cosa giusta."

#: src/trap.c:5665
msgid "You repair the squeaky board."
msgstr "Ripari l'asse che cigola."

#: src/trap.c:5817 src/trap.c:6102
msgid "You disarm it!"
msgstr "Disinneschi la trappola!"

#. prompt
#: src/trap.c:5855 src/trap.c:6086
msgid "Disarm it?"
msgstr "Disinnescare?"

#: src/trap.c:5903
msgid "The perils lurking there are beyond your grasp."
msgstr "I pericoli in agguato laggiù sono fuori dalla tua portata."

#: src/trap.c:5996
msgid "You are already on the edge of the pit."
msgstr "Sei già sul bordo della fossa."

#: src/trap.c:6000
msgid "Try filling the pit instead."
msgstr "Prova invece a riempire la fossa."

#: src/trap.c:6041
msgid "There are no other chests or boxes here."
msgstr "Qui non ci sono altri bauli o casse."

#: src/trap.c:6065
msgid "You know of no traps there."
msgstr "Non conosci trappole lì."

#: src/trap.c:6074
msgid "This door is safely open."
msgstr "Questa porta è aperta, senza rischi."

#: src/trap.c:6084
msgid "You find a trap on the door!"
msgstr "Trovi una trappola sulla porta!"

#: src/trap.c:6093 src/trap.c:6328
msgid "You set it off!"
msgstr "La fai scattare!"

#: src/trap.c:6108
msgid "This door was not trapped."
msgstr "Questa porta non aveva trappole."

#: src/trap.c:6111
msgid "You find no traps on the door."
msgstr "Non trovi trappole sulla porta."

#: src/trap.c:6328
msgid "You trigger a trap!"
msgstr "Fai scattare una trappola!"

#: src/trap.c:6463
msgid "You are jolted by a surge of electricity!"
msgstr "Una scarica elettrica ti investe!"

#: src/trap.c:6466
msgid "You don't seem to be affected."
msgstr "Non sembri risentirne."

#: src/trap.c:6481
msgid "Suddenly you are frozen in place!"
msgstr "All'improvviso una paralisi ti inchioda sul posto!"

#: src/trap.c:6487 src/uhitm.c:3449 src/uhitm.c:6055
msgid "You momentarily stiffen."
msgstr "Per un istante ti irrigidisci."

# JOKE: groovy (hippie) feeling
#: src/trap.c:6497
msgid "What a groovy feeling!"
msgstr "Che sensazione psichedelica!"

#: src/trap.c:6961
msgid "You're still burning."
msgstr "Stai ancora bruciando."

#: src/trap.c:7036
msgid "You sink below the surface and die."
msgstr "Sprofondi sotto la superficie e muori."

#: src/trap.c:7048 src/trap.c:7051
msgid "You sink deeper into the lava."
msgstr "Sprofondi più a fondo nella lava."

#: src/uhitm.c:92
msgid "You avoid harm."
msgstr "Eviti ogni danno."

#: src/uhitm.c:290
msgid "Wait!  There's a hidden monster there!"
msgstr "Aspetta!  Lì c'è un mostro nascosto!"

#: src/uhitm.c:340
msgid "You caitiff!"
msgstr "Che azione ignobile!"

#: src/uhitm.c:344
msgid "You dishonorably attack the innocent!"
msgstr "Attacchi un innocente in modo disonorevole!"

#: src/uhitm.c:526
msgid "You have no way to attack monsters physically."
msgstr "Non hai modo di attaccare i mostri fisicamente."

#: src/uhitm.c:561
msgid "You miss wildly and stumble forwards."
msgstr "Manchi di molto il bersaglio e inciampi in avanti."

#: src/uhitm.c:606
msgid "Your bloodthirsty blade attacks!"
msgstr "La tua lama assetata di sangue attacca!"

#: src/uhitm.c:1520
msgid "You dishonorably use a poisoned weapon!"
msgstr "Usi un'arma avvelenata in modo disonorevole!"

#: src/uhitm.c:1523
msgid "You feel like an evil coward for using a poisoned weapon."
msgstr ""
"Provi un senso di vigliaccheria e malvagità per aver usato un'arma "
"avvelenata."

#. You_feel variant, selected when Unaware
#: src/uhitm.c:1523
msgid ""
"You dream that you feel like an evil coward for using a poisoned weapon."
msgstr ""
"Sogni di provare un senso di vigliaccheria e malvagità per aver usato "
"un'arma avvelenata."

#: src/uhitm.c:1649
msgid "You hit it."
msgstr "Colpisci qualcosa."

# JOKE: hell-p, help from hell
#: src/uhitm.c:2139
msgid "Some hell-p has arrived!"
msgstr "È arrivato un aiuto... infernale!"

#: src/uhitm.c:2384
msgid "You rot!"
msgstr "Marcisci!"

#: src/uhitm.c:2567
msgid "You go up in flames!"
msgstr "Prendi fuoco!"

#: src/uhitm.c:2652
msgid "You're covered in frost!"
msgstr "Un velo di brina ti ricopre!"

#: src/uhitm.c:2654
msgid "The frost doesn't seem cold!"
msgstr "La brina non sembra fredda!"

#: src/uhitm.c:2710
msgid "You get zapped!"
msgstr "Prendi la scossa!"

#: src/uhitm.c:2712
msgid "The zap doesn't shock you!"
msgstr "La scossa non ti fa alcun effetto!"

#: src/uhitm.c:2806
msgid "Your purse feels heavier."
msgstr "Il tuo borsellino si fa più pesante."

#: src/uhitm.c:2890
msgid "You are not affected."
msgstr "Non ne risenti."

#: src/uhitm.c:3033
msgid "You chuckle."
msgstr "Ridacchi."

#: src/uhitm.c:3046 src/uhitm.c:3090
msgid "You hear laughter."
msgstr "Senti una risata."

#. You_hear variant, selected when Underwater
#: src/uhitm.c:3046 src/uhitm.c:3090
msgid "You barely hear laughter."
msgstr "Senti a malapena una risata."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/uhitm.c:3046 src/uhitm.c:3090
msgid "You dream that you hear laughter."
msgstr "Sogni di sentire una risata."

#: src/uhitm.c:3052
msgid "Some writing vanishes from your head!"
msgstr "Una scritta svanisce dalla tua testa!"

#: src/uhitm.c:3137
msgid "Your poison was deadly..."
msgstr "Il tuo veleno era mortale..."

#: src/uhitm.c:3198
msgid "You suck in some slime and don't feel very well."
msgstr "Aspiri un po' di melma e non ti senti molto bene."

#: src/uhitm.c:3226
msgid "You don't seem harmed."
msgstr "Non sembri subire danni."

#: src/uhitm.c:3327
msgid "The barbs stick to you!"
msgstr "Gli uncini si agganciano a te!"

#: src/uhitm.c:3403
msgid "You are being crushed."
msgstr "La stretta ti schiaccia."

#: src/uhitm.c:3452
msgid "You are frozen!"
msgstr "Non riesci più a muoverti!"

#: src/uhitm.c:3504
msgid "You are put to sleep!"
msgstr "Ti fanno cadere nel sonno!"

#: src/uhitm.c:3558
msgid "You escape harm."
msgstr "Scampi al danno."

#: src/uhitm.c:3562
msgid "The slime burns away!"
msgstr "La melma si consuma tra le fiamme!"

#: src/uhitm.c:3566
msgid "You are unaffected."
msgstr "Non subisci alcun effetto."

#: src/uhitm.c:3574
msgid "Yuck!"
msgstr "Bleah!"

#: src/uhitm.c:3707
msgid "You are getting even more confused."
msgstr "Ti si annebbia ancora di più la mente."

#: src/uhitm.c:3709
msgid "You are getting confused."
msgstr "Ti si annebbia la mente."

#: src/uhitm.c:3757
msgid "You aren't transformed."
msgstr "Non subisci alcuna trasformazione."

#: src/uhitm.c:3855
msgid "Was that the touch of death?"
msgstr "Era il tocco della morte?"

#: src/uhitm.c:3870
msgid "You feel your life force draining away..."
msgstr "Senti la tua forza vitale che svanisce..."

#. You_feel variant, selected when Unaware
#: src/uhitm.c:3870
msgid "You dream that you feel your life force draining away..."
msgstr "Sogni di sentire la tua forza vitale che svanisce..."

#: src/uhitm.c:4222
msgid "You hear hissing."
msgstr "Senti un sibilo."

#. You_hear variant, selected when Underwater
#: src/uhitm.c:4222
msgid "You barely hear hissing."
msgstr "Senti a malapena un sibilo."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/uhitm.c:4222
msgid "You dream that you hear hissing."
msgstr "Sogni di sentire un sibilo."

#: src/uhitm.c:4282
msgid "You feel feverish."
msgstr "Senti la febbre salire."

#: src/uhitm.c:4373
msgid "\"Doc, I can't help you unless you cooperate.\""
msgstr "\"Doc, non posso aiutarti se non collabori.\""

# onomatopoeia, kept as is
#: src/uhitm.c:4533
msgid "\"Burrrrp!\""
msgstr "\"Burrrrp!\""

#: src/uhitm.c:4870
msgid "You feel embarrassed for a moment."
msgstr "Provi imbarazzo per un istante."

#. You_feel variant, selected when Unaware
#: src/uhitm.c:4870
msgid "You dream that you feel embarrassed for a moment."
msgstr "Sogni di provare imbarazzo per un istante."

#: src/uhitm.c:4874
msgid "You destroy it!"
msgstr "Distruggi qualcosa!"

#: src/uhitm.c:5038
msgid "Unfortunately, digesting any of it is fatal."
msgstr "Purtroppo, digerirne anche solo un poco è fatale."

#: src/uhitm.c:5204
msgid "Your armor is rather cumbersome..."
msgstr "La tua armatura è piuttosto ingombrante..."

#: src/uhitm.c:5211
msgid "You miss it."
msgstr "Manchi il bersaglio."

#: src/uhitm.c:5909
msgid "You are splashed!"
msgstr "Ti arriva addosso uno schizzo!"

#: src/uhitm.c:5985
msgid "A hail of magic missiles narrowly misses you!"
msgstr "Una pioggia di dardi magici ti manca per un soffio!"

#: src/uhitm.c:5987
msgid "You are hit by magic missiles appearing from thin air!"
msgstr "Dardi magici, comparsi dal nulla, ti colpiscono!"

#: src/uhitm.c:6070
msgid "You feel a mild chill."
msgstr "Senti un lieve brivido di freddo."

#. You_feel variant, selected when Unaware
#: src/uhitm.c:6070
msgid "You dream that you feel a mild chill."
msgstr "Sogni di sentire un lieve brivido di freddo."

#: src/uhitm.c:6076
msgid "You are suddenly very cold!"
msgstr "All'improvviso hai molto freddo!"

#: src/uhitm.c:6093
msgid "You feel mildly warm."
msgstr "Senti un lieve calore."

#. You_feel variant, selected when Unaware
#: src/uhitm.c:6093
msgid "You dream that you feel mildly warm."
msgstr "Sogni di sentire un lieve calore."

#: src/uhitm.c:6099
msgid "You are suddenly very hot!"
msgstr "All'improvviso hai molto caldo!"

#: src/uhitm.c:6106
msgid "You feel a mild tingle."
msgstr "Senti un lieve formicolio."

#. You_feel variant, selected when Unaware
#: src/uhitm.c:6106
msgid "You dream that you feel a mild tingle."
msgstr "Sogni di sentire un lieve formicolio."

#: src/uhitm.c:6112
msgid "You are jolted with electricity!"
msgstr "Una scarica elettrica ti scuote!"

#: src/vault.c:108
msgid "The corridor disappears."
msgstr "Il corridoio scompare."

#: src/vault.c:114
msgid "You are encased in rock."
msgstr "La roccia ti racchiude da ogni parte."

#: src/vault.c:453
msgid "Someone else has entered the Vault."
msgstr "Qualcun altro è entrato nel Caveau."

#: src/vault.c:464
msgid "\"What's going on here?\""
msgstr "\"Che succede qui?\""

#: src/vault.c:467
msgid "The other presence vanishes."
msgstr "L'altra presenza svanisce."

#: src/vault.c:492
msgid "\"I'll be back when you're ready to speak to me!\""
msgstr "\"Tornerò quando avrai voglia di parlarmi!\""

#. prompt
#: src/vault.c:506
msgid "You are required to supply your name. -"
msgstr "Devi fornire il tuo nome. -"

#. prompt
#: src/vault.c:506
msgid "\"Hello stranger, who are you?\" -"
msgstr "\"Salve, chi sei?\" -"

#: src/vault.c:526
msgid "\"Oh, yes, of course.  Sorry to have disturbed you.\""
msgstr "\"Oh, sì, certo.  Scusa il disturbo.\""

#: src/vault.c:538
msgid "\"Back from the dead, are you?  I'll remedy that!\""
msgstr "\"Di ritorno dall'aldilà, eh?  Ci penso io a rimediare!\""

#: src/vault.c:553
msgid "\"I don't know you.\""
msgstr "\"Non ti conosco.\""

#: src/vault.c:562
msgid "\"Please follow me.\""
msgstr "\"Seguimi, per favore.\""

#: src/vault.c:572
msgid "\"You have hidden gold.\""
msgstr "\"Hai dell'oro nascosto.\""

#: src/vault.c:584
msgid "\"Most likely all your gold was stolen from this vault.\""
msgstr ""
"\"Con ogni probabilità tutto il tuo oro è stato rubato da questo caveau.\""

#: src/vault.c:586
msgid "\"Please drop that gold and follow me.\""
msgstr "\"Lascia cadere quell'oro e seguimi, per favore.\""

#: src/vault.c:729
msgid "You hear a distant chant."
msgstr "Senti un canto lontano."

#. You_hear variant, selected when Underwater
#: src/vault.c:729
msgid "You barely hear a distant chant."
msgstr "Senti a malapena un canto lontano."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/vault.c:729
msgid "You dream that you hear a distant chant."
msgstr "Sogni di sentire un canto lontano."

#: src/vault.c:731
msgid "A mysterious force moves the gold into the vault."
msgstr "Una forza misteriosa sposta l'oro nel caveau."

#: src/vault.c:733
msgid "The damaged vault's walls are magically restored!"
msgstr "Le pareti danneggiate del caveau vengono ripristinate per magia!"

#: src/vault.c:972
msgid "\"You've been warned, knave!\""
msgstr "\"Ti avevo avvisato, furfante!\""

#: src/vault.c:1005
msgid "\"Well, begone.\""
msgstr "\"Bene, sparisci.\""

#: src/vault.c:1036
msgid "\"Drop all your gold, scoundrel!\""
msgstr "\"Lascia tutto il tuo oro, canaglia!\""

#: src/vault.c:1046
msgid "\"So be it, rogue!\""
msgstr "\"E sia, briccone!\""

#: src/vault.c:1074
msgid "\"Move along!\""
msgstr "\"Muoviti!\""

#: src/weapon.c:1311
msgid "Skills:"
msgstr "Abilità:"

#: src/weapon.c:1399
msgid "You feel you could be more dangerous!"
msgstr "Senti di poter rappresentare una minaccia maggiore!"

#. You_feel variant, selected when Unaware
#: src/weapon.c:1399
msgid "You dream that you feel you could be more dangerous!"
msgstr "Sogni di sentire di poter rappresentare una minaccia maggiore!"

#: src/were.c:218
msgid "You feel purified."
msgstr "Senti svanire ogni impurità."

#. You_feel variant, selected when Unaware
#: src/were.c:218
msgid "You dream that you feel purified."
msgstr "Sogni di sentire svanire ogni impurità."

#. prompt
#: src/were.c:224
msgid "Remain in beast form?"
msgstr "Restare in forma animale?"

#: src/wield.c:225
msgid "You secure the tether."
msgstr "Fissi la cordicella."

#: src/wield.c:369 src/wield.c:474
msgid "Don't be ridiculous!"
msgstr "Non dire assurdità!"

#: src/wield.c:383
msgid "You are already wielding that!"
msgstr "Stai già impugnando quell'oggetto!"

#: src/wield.c:449
msgid "You cannot wield that!"
msgstr "Non puoi impugnare quell'oggetto!"

#: src/wield.c:499
msgid "You have no secondary weapon readied."
msgstr "Non hai un'arma secondaria pronta."

#: src/wield.c:530
msgid "You have nothing to ready for firing."
msgstr "Non hai nulla da preparare per il tiro."

#: src/wield.c:545
msgid "You now have no ammunition readied."
msgstr "Ora non hai munizioni pronte."

#: src/wield.c:549
msgid "You already have no ammunition readied!"
msgstr "Non hai già alcuna munizione pronta!"

#: src/wield.c:561
msgid "You can't ready only part of your gold."
msgstr "Non puoi preparare solo una parte del tuo oro."

#: src/wield.c:568
msgid "That ammunition is already readied!"
msgstr "Quelle munizioni sono già pronte!"

#: src/wield.c:720
msgid "You can't do that."
msgstr "Non puoi farlo."

#: src/wield.c:772
msgid "You can't use two weapons in your current form."
msgstr "Non puoi usare due armi nella tua forma attuale."

#: src/wield.c:795
msgid "You can't use two weapons while wearing a shield."
msgstr "Non puoi usare due armi mentre indossi uno scudo."

#: src/wield.c:854
msgid "You switch to your primary weapon."
msgstr "Passi alla tua arma primaria."

#: src/wield.c:863
msgid "You begin two-weapon combat."
msgstr "Inizi a combattere con due armi."

#. menu
#: src/windows.c:1734
msgid "Note: when no choices are selected, \"all\" is implied."
msgstr "Nota: se non selezioni nulla, si intende \"tutto\"."

#. menu
#: src/windows.c:1737
msgid "Toggle off 'autopickup' to not pick up anything."
msgstr "Disattiva 'autopickup' per non raccogliere nulla."

#. menu
#: src/windows.c:1737
msgid "Toggle on 'autopickup' to automatically pick these things up."
msgstr "Attiva 'autopickup' per raccogliere automaticamente questi oggetti."

#: src/wizard.c:99
msgid ""
"You get the creepy feeling that somebody noticed your taking the Amulet."
msgstr ""
"Hai la sgradevole sensazione che qualcuno abbia notato che hai preso "
"l'Amuleto."

#: src/wizard.c:775
msgid "A voice booms out..."
msgstr "Una voce rimbomba..."

#: src/wizard.c:793
msgid "You feel vaguely nervous."
msgstr "Avverti un vago nervosismo."

#. You_feel variant, selected when Unaware
#: src/wizard.c:793
msgid "You dream that you feel vaguely nervous."
msgstr "Sogni di avvertire un vago nervosismo."

#: src/wizard.c:864
msgid "\"I shall return.\""
msgstr "\"Io tornerò.\""

#: src/wizard.c:864
msgid "\"I'll be back.\""
msgstr "\"Ritornerò.\""

#: src/worn.c:1199
msgid "You hear a cracking sound."
msgstr "Senti uno scricchiolio."

#. You_hear variant, selected when Underwater
#: src/worn.c:1199
msgid "You barely hear a cracking sound."
msgstr "Senti a malapena uno scricchiolio."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/worn.c:1199
msgid "You dream that you hear a cracking sound."
msgstr "Sogni di sentire uno scricchiolio."

#: src/worn.c:1217 src/worn.c:1226
msgid "You hear a ripping sound."
msgstr "Senti un rumore di strappo."

#. You_hear variant, selected when Underwater
#: src/worn.c:1217 src/worn.c:1226
msgid "You barely hear a ripping sound."
msgstr "Senti a malapena un rumore di strappo."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/worn.c:1217 src/worn.c:1226
msgid "You dream that you hear a ripping sound."
msgstr "Sogni di sentire un rumore di strappo."

#: src/worn.c:1239
msgid "You hear a thud."
msgstr "Senti un tonfo."

#. You_hear variant, selected when Underwater
#: src/worn.c:1239
msgid "You barely hear a thud."
msgstr "Senti a malapena un tonfo."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/worn.c:1239
msgid "You dream that you hear a thud."
msgstr "Sogni di sentire un tonfo."

#: src/worn.c:1283 src/worn.c:1295
msgid "You hear a clank."
msgstr "Senti un clangore."

#. You_hear variant, selected when Underwater
#: src/worn.c:1283 src/worn.c:1295
msgid "You barely hear a clank."
msgstr "Senti a malapena un clangore."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/worn.c:1283 src/worn.c:1295
msgid "You dream that you hear a clank."
msgstr "Sogni di sentire un clangore."

#: src/write.c:89
msgid "You need hands to be able to write!"
msgstr "Ti servono le mani per poter scrivere!"

#: src/write.c:213
msgid "You can't write that!"
msgstr "Non puoi scrivere quello!"

#: src/write.c:214
msgid "It's obscene!"
msgstr "È osceno!"

#: src/write.c:229
msgid "You give up on the idea."
msgstr "Rinunci all'idea."

#: src/write.c:231
msgid "You tear it up."
msgstr "Lo strappi."

#: src/write.c:236
msgid "No mere dungeon adventurer could write that."
msgstr "Nessun semplice avventuriero del dungeon potrebbe scrivere questo."

#: src/write.c:241
msgid "Unfortunately you don't have enough information to go on."
msgstr "Purtroppo non hai abbastanza informazioni per procedere."

#: src/write.c:259
msgid "Your marker is too dry to write that!"
msgstr "Il tuo pennarello è troppo secco per scrivere questo!"

#: src/write.c:272
msgid "Your marker dries out!"
msgstr "Il tuo pennarello si secca!"

#: src/write.c:275
msgid "The spellbook is left unfinished and your writing fades."
msgstr "Il libro di incantesimi resta incompleto e la tua scrittura svanisce."

#: src/write.c:278
msgid "The scroll is now useless and disappears!"
msgstr "La pergamena ora è inutile e scompare!"

#: src/write.c:327
msgid ""
"You write in your best handwriting:  \"My Diary\", but it quickly fades."
msgstr ""
"Scrivi con la tua grafia migliore:  \"Il mio diario\", ma svanisce in fretta."

#: src/write.c:349
msgid "You fail to write the scroll correctly and it disappears."
msgstr "Non riesci a scrivere correttamente la pergamena e questa scompare."

#: src/zap.c:228
msgid "A huge hole opens up..."
msgstr "Si apre un enorme buco..."

#: src/zap.c:589
msgid "You feel a sudden rush of air!"
msgstr "Senti un improvviso spostamento d'aria!"

#. You_feel variant, selected when Unaware
#: src/zap.c:589
msgid "You dream that you feel a sudden rush of air!"
msgstr "Sogni di sentire un improvviso spostamento d'aria!"

#: src/zap.c:1057
msgid "A corpse is resuscitated."
msgstr "Un cadavere viene rianimato."

#: src/zap.c:1247
msgid "You shudder in dread."
msgstr "Rabbrividisci di terrore."

#: src/zap.c:2120
msgid "You smell the odor of meat."
msgstr "Senti odore di carne."

#: src/zap.c:2122
msgid "You smell a delicious smell."
msgstr "Senti un profumo delizioso."

#: src/zap.c:2299 src/zap.c:2309
msgid "You hear a crumbling sound."
msgstr "Senti un rumore di sgretolamento."

#. You_hear variant, selected when Underwater
#: src/zap.c:2299 src/zap.c:2309
msgid "You barely hear a crumbling sound."
msgstr "Senti a malapena un rumore di sgretolamento."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/zap.c:2299 src/zap.c:2309
msgid "You dream that you hear a crumbling sound."
msgstr "Sogni di sentire un rumore di sgretolamento."

#: src/zap.c:2307
msgid "The statue shatters."
msgstr "La statua va in frantumi."

# JOKE: hallucinated reviving sound
#: src/zap.c:2393
msgid "You hear a defibrillator."
msgstr "Senti un defibrillatore."

#. You_hear variant, selected when Underwater
#: src/zap.c:2393
msgid "You barely hear a defibrillator."
msgstr "Senti a malapena un defibrillatore."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/zap.c:2393
msgid "You dream that you hear a defibrillator."
msgstr "Sogni di sentire un defibrillatore."

#: src/zap.c:2533
msgid "You wrest one last charge from the worn-out wand."
msgstr "Strappi un'ultima carica alla bacchetta esaurita."

#: src/zap.c:2591
msgid "Unfortunately, nothing happens."
msgstr "Purtroppo non succede nulla."

#: src/zap.c:2647
msgid "You aren't able to zap anything in your current form."
msgstr "Nella tua forma attuale non sei in grado di usare bacchette."

#: src/zap.c:2735
msgid "You bash yourself!"
msgstr "Ti colpisci con forza!"

#: src/zap.c:2748
msgid "You shock yourself!"
msgstr "Ti dai una scossa!"

#: src/zap.c:2754
msgid "You zap yourself, but seem unharmed."
msgstr "Usi la bacchetta su di te, ma non sembri subire danni."

#: src/zap.c:2763
msgid "You explode a fireball on top of yourself!"
msgstr "Fai esplodere una palla di fuoco proprio su di te!"

#: src/zap.c:2772
msgid "You feel rather warm."
msgstr "Senti piuttosto caldo."

#. You_feel variant, selected when Unaware
#: src/zap.c:2772
msgid "You dream that you feel rather warm."
msgstr "Sogni di sentire piuttosto caldo."

#: src/zap.c:2776
msgid "You've set yourself afire!"
msgstr "Ti dai fuoco!"

#: src/zap.c:2793
msgid "You feel a little chill."
msgstr "Senti un po' di freddo."

#. You_feel variant, selected when Unaware
#: src/zap.c:2793
msgid "You dream that you feel a little chill."
msgstr "Sogni di sentire un po' di freddo."

#: src/zap.c:2797
msgid "You imitate a popsicle!"
msgstr "Diventi un ghiacciolo!"

#: src/zap.c:2809
msgid "The missiles bounce!"
msgstr "I dardi rimbalzano!"

#: src/zap.c:2813
msgid "Idiot!  You've shot yourself!"
msgstr "Idiota!  Ti sei sparato addosso!"

#: src/zap.c:2870
msgid "You don't feel sleepy!"
msgstr "Non senti sonno!"

#: src/zap.c:2874
msgid "The sleep ray hits you!"
msgstr "Il raggio del sonno ti colpisce!"

#: src/zap.c:2876
msgid "You fall asleep!"
msgstr "Ti addormenti!"

#: src/zap.c:2902
msgid "The wand shoots an apparently harmless beam at you."
msgstr "La bacchetta ti lancia un raggio all'apparenza innocuo."

#: src/zap.c:2912
msgid "You irradiate yourself with pure energy!"
msgstr "Ti irradi di pura energia!"

#: src/zap.c:3206
msgid "Your amulet grows hot for a moment, then cools."
msgstr "Il tuo amuleto si scalda per un istante, poi si raffredda."

#: src/zap.c:3275
msgid "Your probe reveals nothing."
msgstr "La tua sonda non rivela nulla."

#: src/zap.c:3293
msgid "The stairs seem to ripple momentarily."
msgstr "Le scale sembrano ondeggiare per un istante."

#: src/zap.c:3343
msgid "There's a trapdoor beneath you; it shatters."
msgstr "C'è una botola sotto di te; va in frantumi."

#: src/zap.c:3345
msgid "The trapdoor beneath you shatters."
msgstr "La botola sotto di te va in frantumi."

#: src/zap.c:3362
msgid "A trapdoor appears beneath you."
msgstr "Una botola appare sotto di te."

#: src/zap.c:3439
msgid "You feel shuddering vibrations."
msgstr "Senti vibrazioni tremolanti."

#. You_feel variant, selected when Unaware
#: src/zap.c:3439
msgid "You dream that you feel shuddering vibrations."
msgstr "Sogni di sentire vibrazioni tremolanti."

#: src/zap.c:3684
msgid "The floor runs like butter!"
msgstr "Il pavimento scorre come burro!"

#: src/zap.c:3684
msgid "The edges on the floor get smoother."
msgstr "Gli spigoli sul pavimento si fanno più lisci."

#: src/zap.c:3757
msgid "Probing reveals a secret door."
msgstr "Il sondaggio rivela una porta segreta."

#: src/zap.c:3770
msgid "Probing exposes a secret corridor."
msgstr "Il sondaggio svela un corridoio segreto."

#: src/zap.c:4227
msgid "You skillfully catch the boomerang."
msgstr "Afferri con abilità il boomerang."

#: src/zap.c:4236
msgid "Klonk!"
msgstr "Clonk!"

#: src/zap.c:4439
msgid "You don't feel hot!"
msgstr "Non senti caldo!"

#: src/zap.c:4458
msgid "You don't feel cold."
msgstr "Non senti freddo."

#: src/zap.c:4471
msgid "You don't feel sleepy."
msgstr "Non senti sonno."

#: src/zap.c:4483
msgid "You are not disintegrated."
msgstr "La disintegrazione non ti colpisce."

#: src/zap.c:4509
msgid "You seem unaffected."
msgstr "Non sembri risentirne."

#: src/zap.c:4514 src/zap.c:4528
msgid "You aren't affected."
msgstr "Non ne risenti."

#: src/zap.c:4922
msgid "It seems even stronger than before."
msgstr "Sembra ancora più forte di prima."

#: src/zap.c:4985
msgid "For some reason you are not affected."
msgstr "Per qualche motivo non ne risenti."

#: src/zap.c:5182
msgid "A web bursts into flames!"
msgstr "Una ragnatela prende fuoco!"

#: src/zap.c:5246
msgid "Steam billows from the fountain."
msgstr "Il vapore si leva dalla fontana."

#: src/zap.c:5265
msgid "You hear a soft crackling."
msgstr "Senti un lieve crepitio."

#. You_hear variant, selected when Underwater
#: src/zap.c:5265
msgid "You barely hear a soft crackling."
msgstr "Senti a malapena un lieve crepitio."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/zap.c:5265
msgid "You dream that you hear a soft crackling."
msgstr "Sogni di sentire un lieve crepitio."

#: src/zap.c:5305
msgid "You hear a crackling sound."
msgstr "Senti un crepitio."

#. You_hear variant, selected when Underwater
#: src/zap.c:5305
msgid "You barely hear a crackling sound."
msgstr "Senti a malapena un crepitio."

#. You_hear variant, selected when Unaware (and not Underwater)
#: src/zap.c:5305
msgid "You dream that you hear a crackling sound."
msgstr "Sogni di sentire un crepitio."

#: src/zap.c:5316
msgid "You pass through the now-solid rock."
msgstr "Attraversi la roccia ormai solida."

#: src/zap.c:5320
msgid "You are firmly stuck in the cooling rock."
msgstr "La roccia che si raffredda ti blocca saldamente."

#: src/zap.c:5471
msgid "The door remains intact."
msgstr "La porta rimane intatta."

#: src/zap.c:5476
msgid "You feel vibrations."
msgstr "Senti delle vibrazioni."

#. You_feel variant, selected when Unaware
#: src/zap.c:5476
msgid "You dream that you feel vibrations."
msgstr "Sogni di sentire delle vibrazioni."

#: src/zap.c:5613
msgid "You feel guilty about damaging such a historic statue."
msgstr "Ti senti in colpa per aver danneggiato una statua così storica."

#. You_feel variant, selected when Unaware
#: src/zap.c:5613
msgid "You dream that you feel guilty about damaging such a historic statue."
msgstr ""
"Sogni di sentirti in colpa per aver danneggiato una statua così storica."

#: src/zap.c:5954
msgid "You aren't hurt!"
msgstr "Non ti fai male!"

#. putstr
#: src/zap.c:6216
msgid "Wish details:"
msgstr "Dettagli sul desiderio:"

# the quoted example names stay English: the wish parser only understands English names
#. putstr
#: src/zap.c:6216
msgid "Enter the name of an object, such as \"potion of monster detection\","
msgstr ""
"Inserisci il nome di un oggetto, ad esempio \"potion of monster detection\","

#. putstr
#: src/zap.c:6216
msgid "\"scroll labeled README\", \"elven mithril-coat\", or \"Grimtooth\""
msgstr "\"scroll labeled README\", \"elven mithril-coat\" o \"Grimtooth\""

#. putstr
#: src/zap.c:6216
msgid "(without the quotes)."
msgstr "(senza le virgolette)."

#. putstr
#: src/zap.c:6216
msgid "For object types which come in stacks, you may specify a plural name"
msgstr ""
"Per i tipi di oggetto che si presentano in pile, puoi indicare un nome al "
"plurale"

#. putstr
#: src/zap.c:6216
msgid "such as \"potions of healing\", or specify a count, such as \"1000 gold"
msgstr ""
"come \"potions of healing\", oppure indicare una quantità, come \"1000 gold"

#. putstr
#: src/zap.c:6216
msgid "pieces\", although that aspect of your wish might not be granted."
msgstr ""
"pieces\", anche se quest'aspetto del desiderio potrebbe non essere esaudito."

#. putstr
#: src/zap.c:6216
msgid "You may also specify various prefix values which might be used to"
msgstr "Puoi anche indicare vari prefissi che possono servire a"

#. putstr
#: src/zap.c:6216
msgid "modify the item, such as \"uncursed\" or \"rustproof\" or \"+1\"."
msgstr "modificare l'oggetto, come \"uncursed\" o \"rustproof\" o \"+1\"."

#. putstr
#: src/zap.c:6216
msgid "Most modifiers shown when viewing your inventory can be specified."
msgstr ""
"Si può indicare la maggior parte dei modificatori mostrati nell'inventario."

#. putstr
#: src/zap.c:6216
msgid "You may specify 'nothing' to explicitly decline this wish."
msgstr "Puoi indicare 'nothing' per rifiutare esplicitamente questo desiderio."

#: src/zap.c:6341
msgid "You may wish for an object."
msgstr "Puoi desiderare un oggetto."

#: src/zap.c:6376
msgid "Nothing fitting that description exists in the game."
msgstr "Nel gioco non esiste nulla che corrisponda a quella descrizione."
