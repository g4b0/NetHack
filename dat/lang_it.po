#: src/mhitu.c:1464
msgid "Ouch!  You've been slimed!"
msgstr "Ahi!  Ti arriva addosso della melma!"

#: src/mhitu.c:1466
msgid "You are covered in slime!  It burns!"
msgstr "La melma ti ricopre!  Brucia!"

#: src/mhitu.c:1477
msgid "You can't see in here!"
msgstr "Qui dentro non vedi nulla!"

#: src/mhitu.c:1489
msgid "The air around you crackles with electricity."
msgstr "L'aria intorno a te crepita di elettricità."

#: src/mhitu.c:1492
msgid "You seem unhurt."
msgstr "Sembra che tu non abbia riportato danni."

#: src/mhitu.c:1506
msgid "You feel mildly chilly."
msgstr "Senti un lieve freddo."

#. You_feel variant, selected when Unaware
#: src/mhitu.c:1506
msgid "You dream that you feel mildly chilly."
msgstr "Sogni di sentire un lieve freddo."

#: src/mhitu.c:1511
msgid "You are freezing to death!"
msgstr "Stai morendo di freddo!"

#: src/mhitu.c:1521
msgid "You feel mildly hot."
msgstr "Senti un lieve calore."

#. You_feel variant, selected when Unaware
#: src/mhitu.c:1521
msgid "You dream that you feel mildly hot."
msgstr "Sogni di sentire un lieve calore."

#: src/mhitu.c:1526
msgid "You are burning to a crisp!"
msgstr "Ti stai carbonizzando!"

#: src/mhitu.c:1628
msgid "You are blinded by a blast of light!"
msgstr "Una vampata di luce ti acceca!"

# JOKE: not terribly bright
#: src/mhitu.c:1633
msgid "You get the impression it was not terribly bright."
msgstr "Hai l'impressione che non fosse una gran luce."

#: src/mhitu.c:1643
msgid "You are caught in a blast of kaleidoscopic light!"
msgstr "Un'esplosione di luce caleidoscopica ti investe!"

#: src/mhitu.c:1657
msgid "You seem unaffected by it."
msgstr "Sembra che tu non ne risenta."

# JOKE: overdue haircut pun
#: src/mhitu.c:1713
msgid "Someone seems overdue for a serpent cut."
msgstr "Qualcuno avrebbe proprio bisogno di una spuntatina ai serpenti."

#: src/mhitu.c:1772
msgid "You are getting more and more confused."
msgstr "La tua confusione cresce sempre di più."

#: src/mhitu.c:1836 src/uhitm.c:2573
msgid "The fire doesn't feel hot!"
msgstr "Il fuoco non ti sembra caldo!"

#: src/mhitu.c:2006
msgid "Someone caresses you..."
msgstr "Qualcuno ti accarezza..."

#: src/mhitu.c:2074
msgid "and puts it on your finger."
msgstr "e te lo infila al dito."

#: src/mhitu.c:2184
msgid "You feel drained of energy."
msgstr "Senti l'energia abbandonarti."

#. You_feel variant, selected when Unaware
#: src/mhitu.c:2184
msgid "You dream that you feel drained of energy."
msgstr "Sogni di sentire l'energia abbandonarti."

#: src/mhitu.c:2192
msgid "You are down in the dumps."
msgstr "Sei giù di morale."

#: src/mhitu.c:2198
msgid "Your senses are dulled."
msgstr "I tuoi sensi si ottundono."

#: src/mhitu.c:2205
msgid "You feel out of shape."
msgstr "Ti senti fuori forma."

#. You_feel variant, selected when Unaware
#: src/mhitu.c:2205
msgid "You dream that you feel out of shape."
msgstr "Sogni di sentirti fuori forma."

#: src/mhitu.c:2208
msgid "You have a curious feeling..."
msgstr "Hai una strana sensazione..."

#: src/mhitu.c:2217
msgid "You feel exhausted."
msgstr "Ti senti senza forze."

#. You_feel variant, selected when Unaware
#: src/mhitu.c:2217
msgid "You dream that you feel exhausted."
msgstr "Sogni di sentirti senza forze."

#: src/mhitu.c:2229
msgid "You feel raised to your full potential."
msgstr "Ti senti al massimo del tuo potenziale."

#. You_feel variant, selected when Unaware
#: src/mhitu.c:2229
msgid "You dream that you feel raised to your full potential."
msgstr "Sogni di sentirti al massimo del tuo potenziale."

#: src/mhitu.c:2236
