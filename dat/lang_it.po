#. prompt
#: src/cmd.c:904
msgid "Hide [h] or spin a web [s]?"
msgstr "Nasconderti [h] o tessere una ragnatela [s]?"

#: src/cmd.c:934
msgid "There is no fountain here."
msgstr "Qui non c'è nessuna fontana."

#: src/cmd.c:940
msgid "You shriek."
