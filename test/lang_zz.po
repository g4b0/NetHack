msgstr[1] "ZZ-MANY"

msgid "one cat"
msgid_plural "many cats"
msgstr[0] "ZZ-CAT1"
msgstr[1] "ZZ-CAT2"
msgstr[2] "ZZ-CAT3"

msgid "one dog"
msgid_plural "many dogs"
msgstr[0] "ZZ-DOG"

msgid "one cow"
msgid_plural "many cows"
msgstr[0] "ZZ-COW"
msgstr[1] ""

